    <queryString>
        <![CDATA[SELECT HDR.DOC_REF,HDR.RECEIPT_NUM,HDR.BL_NUMBER,TO_CHAR(HDR.TRANSACTION_DATE,'DD-MON-YYYY') TRANSACTION_DATE,
HDR.CREATED_BY,CHQ_CARDNO,TO_CHAR(CHQ_DATE,'DD-MON-YYYY') CHQ_DATE,HDR.PAYING_TO,HDR.REMARKS,DTL.AMOUNT,
LISTAGG(ASR.CONTAINER_NO,'; ') WITHIN GROUP (ORDER BY ASR.CONTAINER_NO) AS CONTAINER_NO,DTL.REF_DOC_POID,DTL.REF_DOC_ID
FROM GL_IMCO_CHEQUE_REFUND_HDR HDR
INNER JOIN GL_IMCO_CHEQUE_REFUND_DTL DTL ON HDR.TRANSACTION_POID =DTL.TRANSACTION_POID
LEFT JOIN AR_SH_RECEIPT_CONTAINER_DTL ASR ON ASR.TRANSACTION_POID=DTL.REF_DOC_POID AND REF_DOC_ID='300-103'
WHERE HDR.TRANSACTION_POID =$P{DOC_KEY_POID}
GROUP BY HDR.DOC_REF,HDR.RECEIPT_NUM,HDR.BL_NUMBER,HDR.TRANSACTION_DATE,
HDR.CREATED_BY,CHQ_CARDNO,CHQ_DATE,HDR.PAYING_TO,HDR.REMARKS,DTL.AMOUNT,DTL.REF_DOC_POID,DTL.REF_DOC_ID]]>
    </queryString>
