	<queryString>
		<![CDATA[select distinct HDR.TRANSACTION_POID, NVL(ASM.SUPPLIER_NAME, SPM.PRINCIPAL_NAME) as SUPPLIER_NAME, HDR.DOC_REF, TO_CHAR(HDR.TRANSACTION_DATE,'DD-MON-YYYY') as TRANSACTION_DATE,
TO_CHAR(HDR.SUPPLIER_INV_DATE,'DD-MON-YYYY') as SUPPLIER_INV_DATE, SUPPLIER_INV_NO,
HDR.BHD_AMOUNT AS AMOUNT, HDR.REF_TYPE, HDR.NARRATION, 'Bahraini Dinar : '||FN_AMOUNT_IN_WORDS_COMMON(HDR.BHD_AMOUNT,'BHD') AMOUNT_IN_WORD, HDR.CREATED_BY
from AP_PURCHASE_INVOICE_HDR HDR
left join AP_SUPPLIER_MASTER ASM on ASM.SUPPLIER_POID = HDR.SUPPLIER_POID and hdr.party_type='SUPPLIER'
left join SHIP_PRINCIPAL_MASTER SPM on SPM.PRINCIPAL_POID = HDR.SUPPLIER_POID and hdr.party_type='PRINCIPAL'
where TRANSACTION_POID = $P{DOC_KEY_POID}]]>
	</queryString>
