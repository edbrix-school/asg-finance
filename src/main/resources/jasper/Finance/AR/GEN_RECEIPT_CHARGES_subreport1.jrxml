        <![CDATA[SELECT INITCAP(CHARGE_TYPE) AS CHARGE_TYPE, BHD_AMOUNT, TAX_AMOUNT, TOTAL_AMOUNT
FROM AR_GEN_RECEIPT_CHARGES_DTL
WHERE TRANSACTION_POID=$P{DOC_KEY_POID}]]>
