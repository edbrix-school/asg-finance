	<queryString>
		<![CDATA[SELECT CVH.TRANSACTION_POID, CVH.TRANSACTION_DATE, CVH.COMPANY_POID, CVH.DOC_REF,
CVH.CURRENCY_CODE, CVH.CURRENCY_RATE, CVH.DR_TOTAL, CVH.CR_TOTAL,
CVH.POSTING_NARRATION, CVH.REMARKS, CVH.DELETED, CVH.MULTI_COMPANY,
CVH.CREDIT_GL, CVH.DEBIT_GL, CVH.AMOUNT, CVH.CHEQUE_DATE, CVH.CHEQUE_NO,
CVH.MANUAL FROM GL_CONTRA_VOUCHER_HDR CVH
WHERE CVH.TRANSACTION_POID=$P{DOC_KEY_POID}]]>
	</queryString>
