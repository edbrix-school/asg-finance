    <subDataset name="Detail_Table" uuid="6eda5f6a-2a11-40a7-be1b-ac5987ed64d3">
        <parameter name="DOC_KEY_POID" class="java.lang.String" isForPrompting="false">
            <defaultValueExpression><![CDATA[]]></defaultValueExpression>
        </parameter>
        <queryString>
            <![CDATA[SELECT DISTINCT DOCUMENT_NO,DOCUMENT_DATE,AMOUNT,crdr_type FROM(
      SELECT PHDR.DOC_REF DOCUMENT_NO,TO_CHAR(PHDR.transaction_date,'DD-MON-YYYY') DOCUMENT_DATE,
      ROUND(SUM(NVL(BKID.PO_QTY,0)*NVL(BKID.PRICE,0)),3) AS AMOUNT,'DR' crdr_type
      FROM GL_BANK_PAYMENT_ITEM_DTL BKID
      INNER JOIN GL_BANK_PAYMENT_HDR HDR
      ON BKID.TRANSACTION_POID = HDR.TRANSACTION_POID
      INNER JOIN AP_PURCHASE_ORDER_HDR PHDR
      ON HDR.PO_REF = PHDR.TRANSACTION_POID
      WHERE BKID.TRANSACTION_POID= $P{DOC_KEY_POID} and HDR.REF_TYPE = 'GENERAL PO'
      GROUP BY PHDR.DOC_REF,TO_CHAR(PHDR.transaction_date,'DD-MON-YYYY')
      union all
      SELECT PHDR.DOC_REF DOCUMENT_NO,TO_CHAR(PHDR.transaction_date,'DD-MON-YYYY') DOCUMENT_DATE,
      ROUND(SUM(NVL(BKID.PO_QTY,0)*NVL(BKID.PRICE,0)),3) AS AMOUNT,'DR' crdr_type
      FROM GL_BANK_PAYMENT_ITEM_DTL BKID
      INNER JOIN GL_BANK_PAYMENT_HDR HDR
      ON BKID.TRANSACTION_POID = HDR.TRANSACTION_POID
      INNER JOIN AP_REQUEST_FOR_QTN_HDR PHDR
      ON HDR.SALES_QTN_REF = PHDR.TRANSACTION_POID
      WHERE BKID.TRANSACTION_POID= $P{DOC_KEY_POID} and  HDR.REF_TYPE = 'MTA RFQ'
      GROUP BY PHDR.DOC_REF,TO_CHAR(PHDR.transaction_date,'DD-MON-YYYY')
      union all
      select fhdr.DOC_REF DOCUMENT_NO ,TO_CHAR(fhdr.transaction_date,'DD-MON-YYYY') DOCUMENT_DATE ,SUM(CHARGE_AMOUNT) AS AMOUNT,'DR' crdr_type
      FROM GL_BANK_PAYMENT_CHARGE_DTL BKID
      inner join GL_BANK_PAYMENT_HDR HDR
       ON BKID.TRANSACTION_POID = HDR.TRANSACTION_POID
      inner join FF_MANIEST_HDR fhdr
      on BKID.REF_DOC_POID = fhdr.TRANSACTION_POID
      where BKID.TRANSACTION_POID= $P{DOC_KEY_POID} and  HDR.REF_TYPE = 'FF JOBS'
      group by fhdr.DOC_REF,TO_CHAR(fhdr.transaction_date,'DD-MON-YYYY')
      union all
      select fhdr.DOC_REF DOCUMENT_NO ,TO_CHAR(hdr.transaction_date,'DD-MON-YYYY') DOCUMENT_DATE ,sum(BKID.charge_amount) AMOUNT,'DR' crdr_type
      from GL_BANK_PAYMENT_CHARGE_DTL BKID
       INNER JOIN GL_BANK_PAYMENT_HDR HDR
      ON BKID.TRANSACTION_POID = HDR.TRANSACTION_POID
      inner join PDA_FDA_HDR fhdr
       on HDR.fda_ref = fhdr.TRANSACTION_POID
      where BKID.TRANSACTION_POID= $P{DOC_KEY_POID} and  HDR.REF_TYPE = 'FDA JOBS'
       group by fhdr.DOC_REF,TO_CHAR(hdr.transaction_date,'DD-MON-YYYY')
      union all
      select brkup.BILL_REF DOCUMENT_NO ,TO_CHAR(brkup.BILL_DUE_DATE,'DD-MON-YYYY') DOCUMENT_DATE ,nvl(sum(dr_amt),sum(nvl(cr_amt,0))) AMOUNT,decode(sum(dr_amt),null,'CR',0,'CR','DR') crdr_type
      from gl_bank_payment_hdr bhdr
      inner join gl_voucher_bill_breakup_dtl brkup
      on bhdr.TRANSACTION_POID = brkup.TRANSACTION_POID and doc_id = '400-107'
      WHERE bhdr.TRANSACTION_POID =  $P{DOC_KEY_POID} and  bhdr.REF_TYPE = 'GENERAL'
      group by brkup.BILL_REF,TO_CHAR(brkup.BILL_DUE_DATE,'DD-MON-YYYY')
       ) where rownum < 23 order by DOCUMENT_NO]]>
        </queryString>
        <field name="DOCUMENT_NO" class="java.lang.String"/>
        <field name="DOCUMENT_DATE" class="java.lang.String"/>
        <field name="AMOUNT" class="java.math.BigDecimal"/>
        <field name="CRDR_TYPE" class="java.lang.String"/>
    </subDataset>
    <subDataset name="dataset1" uuid="19381718-ccae-45d4-bcae-4b11fbf879bf"/>
    <parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_COMP_POID" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_USER_POID" class="java.lang.String"/>
    <parameter name="DOC_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
    </parameter>
    <parameter name="DOC_KEY_POID" class="java.lang.String"/>
    <parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
    </parameter>
    <parameter name="CURRENT_CHEQUE_NO" class="java.lang.String"/>
    <parameter name="BANK_POID" class="java.lang.String"/>
    <parameter name="ACCOUNT_PAYEE_IMG" class="java.lang.String"/>
    <queryString>
        <![CDATA[select distinct TRANSACTION_POID, paying_to,doc_ref,to_char(transaction_date,'DD-MON-YYYY') transaction_date,TO_CHAR(CHQ_DATE,'DD-MON-YYYY')CHQ_DATE,
CURRENCY_AMOUNT,regexp_replace(to_char(CHQ_DATE,'DDMMYYYY'), '(.)', '\1    ' )CHQ_DATE_FRT,
to_char(CHQ_DATE,'DDMMYYYY') DateString,
FN_AMOUNT_IN_WORDS_COMMON(CURRENCY_AMOUNT,'BHD') AMOUNT_IN_WORD,REF_TYPE,BANK_PREFIX,LONG_NARRATION,HDR.CREATED_BY,(select user_id from GLOBAL_USERS where user_poid = $P{LOGIN_USER_POID}) user_id,
decode(upper(trim(paying_to)),'CASH','N',ACCOUNT_PAYEE) ACCOUNT_PAYEE,
(  select COUNT(*)  BILLWISE_COUNT
      from gl_bank_payment_hdr bhdr
      inner join gl_voucher_bill_breakup_dtl brkup
      on bhdr.TRANSACTION_POID = brkup.TRANSACTION_POID and doc_id = '400-107'
      WHERE bhdr.TRANSACTION_POID =   $P{DOC_KEY_POID} and  bhdr.REF_TYPE = 'GENERAL') billwise_count
FROM GL_BANK_PAYMENT_HDR HDR
INNER JOIN GL_BANK_MASTER BKHDR
ON BKHDR.BANK_POID = $P{BANK_POID}
WHERE TRANSACTION_POID = $P{DOC_KEY_POID}]]>
    </queryString>
