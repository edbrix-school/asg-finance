<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="JournalVoucherAssetDisposalSubreport2" language="groovy" pageWidth="530" pageHeight="595" orientation="Landscape" columnWidth="530" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="5a6587f0-41bf-4c7e-9d50-0e1ab7d7233c">
    <property name="ireport.zoom" value="1.3310000000000004"/>
    <property name="ireport.x" value="1"/>
    <property name="ireport.y" value="0"/>
    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_COMP_POID" class="java.lang.String"/>
    <queryString>
        <![CDATA[SELECT TRANSACTION_POID,
JVA.FA_POID, FAM.FA_CODE||'-'||JVA.FA_DESCRIPTION AS FA_DESCRIPTION, FAC.FA_CATG_DESCRIPTION, JVA.ASSET_TYPE, JVA.LIFE_YEAR, JVA.PURCHASE_DATE, JVA.DEPRECIATION_START_DATE,T.FA_CODE||T.FA_DESCRIPTION||T.FA_CATG_DESCRIPTION||T.ASSET_TYPE AS FA_DETAILS,
JVA.SCRAP_SOLD_DATE, JVA.ASSET_VALUE, JVA.DEPRECIATED_AMT, JVA.WDV_VALUE, JVA.PROCESS, JVA.SCRAP_SOLD_VALUE, JVA.REMARKS
FROM GL_JOURNAL_VOUCHER_ASSET_DTL JVA
INNER JOIN FIXED_ASSET_MASTER FAM ON FAM.FA_POID=JVA.FA_POID
INNER JOIN FIXED_ASSET_CATEGORY_MASTER FAC ON FAC.FA_CATEGORY_POID=JVA.FA_CATEGORY
LEFT JOIN
(
SELECT FAM1.FA_POID,
CASE WHEN FAM1.FA_CODE IS NOT NULL THEN FAM1.FA_CODE END AS FA_CODE,
CASE WHEN JVA1.FA_DESCRIPTION IS NOT NULL THEN CHR (13)||JVA1.FA_DESCRIPTION END AS FA_DESCRIPTION,
CASE WHEN FAC1.FA_CATG_DESCRIPTION IS NOT NULL THEN CHR (13)||'Fa Categ:-'||FAC1.FA_CATG_DESCRIPTION END AS FA_CATG_DESCRIPTION,
CASE WHEN JVA1.ASSET_TYPE IS NOT NULL THEN CHR (13)||JVA1.ASSET_TYPE END AS ASSET_TYPE
FROM GL_JOURNAL_VOUCHER_ASSET_DTL JVA1
INNER JOIN FIXED_ASSET_MASTER FAM1 ON FAM1.FA_POID=JVA1.FA_POID
INNER JOIN FIXED_ASSET_CATEGORY_MASTER FAC1 ON FAC1.FA_CATEGORY_POID=JVA1.FA_CATEGORY
) T ON T.FA_POID=JVA.FA_POID
WHERE TRANSACTION_POID=$P{DOC_KEY_POID}]]>
    </queryString>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="FA_POID" class="java.math.BigDecimal"/>
    <field name="FA_DESCRIPTION" class="java.lang.String"/>
    <field name="FA_CATG_DESCRIPTION" class="java.lang.String"/>
    <field name="ASSET_TYPE" class="java.lang.String"/>
    <field name="LIFE_YEAR" class="java.math.BigDecimal"/>
    <field name="PURCHASE_DATE" class="java.sql.Timestamp"/>
    <field name="DEPRECIATION_START_DATE" class="java.sql.Timestamp"/>
    <field name="FA_DETAILS" class="java.lang.String"/>
