	<queryString>
		<![CDATA[SELECT TRANSACTION_POID, PAYING_TO , DOC_REF, TRANSACTION_DATE, CHQ_DATE, CURRENCY_AMOUNT, CHQ_DATE_FRT, DATESTRING, AMOUNT_IN_WORD,  REF_TYPE, LONG_NARRATION, CREATED_BY, ACCOUNT_PAYEE
FROM(
    SELECT DISTINCT TRANSACTION_POID, PAYING_TO, DOC_REF,
    TO_CHAR(TRANSACTION_DATE,'DD-MON-YYYY') TRANSACTION_DATE, TO_CHAR(CHQ_DATE,'DD-MON-YYYY')CHQ_DATE,
    CURRENCY_AMOUNT, REGEXP_REPLACE(TO_CHAR(CHQ_DATE,'DDMMYYYY'), '(.)', '\1    ' )CHQ_DATE_FRT,
    TO_CHAR(CHQ_DATE,'DDMMYYYY') DATESTRING,
    FN_AMOUNT_IN_WORDS_COMMON(CURRENCY_AMOUNT,'BHD')||'.' AMOUNT_IN_WORD, REF_TYPE, LONG_NARRATION, HDR.CREATED_BY,
    DECODE(UPPER(TRIM(PAYING_TO)),'CASH','N',ACCOUNT_PAYEE) ACCOUNT_PAYEE
    FROM GL_BANK_PAYMENT_HDR HDR
    WHERE TRANSACTION_POID =$P{DOC_KEY_POID}
    )]]>
	</queryString>
