    <parameter name="DOC_KEY_POID" class="java.lang.String"/>
    <queryString>
        <![CDATA[SELECT PYMT_TYPE AS PYMT_TYPE, AMOUNT, CHQ_DATE, CHQ_CARDNO, ACCOUNT_NAME, ACCOUNT_NO, CBM.BANK_CODE
FROM AR_GEN_RECEIPT_PYMT_DETAILS RPD
LEFT JOIN GLOBAL_CUSTOMER_BANK_MASTER CBM ON CBM.BANK_POID=RPD.BANK_POID
WHERE TRANSACTION_POID=$P{DOC_KEY_POID}]]>
    </queryString>
    <field name="PYMT_TYPE" class="java.lang.String"/>
