	<subDataset name="DetailTable" uuid="969f79a2-7618-4167-b715-b1b98df4b6aa">
		<parameter name="DOC_KEY_POID" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT TO_CHAR(TRANSACTION_DATE,'DD-MON-YYYY') TT_DATE, HDR.REMARKS,DR_AMT,'DR' DRCRTYPE
FROM  GL_BANK_DEBIT_DTL_GL DTL
INNER JOIN GL_BANK_DEBIT_HDR HDR ON HDR.TRANSACTION_POID = DTL.TRANSACTION_POID
WHERE DTL.TRANSACTION_POID                               = $P{DOC_KEY_POID} AND UPPER(DTL.TYPE) = 'DR' AND (REF_TYPE                                 = 'GENERAL' OR REF_TYPE = 'CUSTOM')

UNION ALL
SELECT TO_CHAR(HDR.TRANSACTION_DATE,'DD-MON-YYYY') TT_DATE, 'FF JOB ' ||FHDR.DOC_REF REMARKS ,SUM(
      CHARGE_AMOUNT) AS DR_AMT,'DR' DRCRTYPE
FROM  GL_BANK_DEBIT_CHARGE_DTL BKID
INNER JOIN GL_BANK_DEBIT_HDR HDR ON BKID.TRANSACTION_POID = HDR.TRANSACTION_POID
INNER JOIN FF_MANIEST_HDR FHDR   ON BKID.REF_DOC_POID     = FHDR.TRANSACTION_POID
WHERE BKID.TRANSACTION_POID                               = $P{DOC_KEY_POID} AND HDR.REF_TYPE = 'FF JOBS'
GROUP BY FHDR.DOC_REF,TO_CHAR(HDR.TRANSACTION_DATE,'DD-MON-YYYY')

UNION ALL
SELECT TO_CHAR(HDR.TRANSACTION_DATE,'DD-MON-YYYY') TT_DATE, 'FDA JOB ' ||FHDR.DOC_REF REMARKS ,SUM(
      CHARGE_AMOUNT) AS DR_AMT,'DR' DRCRTYPE
FROM  GL_BANK_DEBIT_CHARGE_DTL BKID
INNER JOIN GL_BANK_DEBIT_HDR HDR ON BKID.TRANSACTION_POID = HDR.TRANSACTION_POID
INNER JOIN PDA_FDA_HDR FHDR      ON HDR.FDA_REF           = FHDR.TRANSACTION_POID
WHERE BKID.TRANSACTION_POID                               = $P{DOC_KEY_POID} AND HDR.REF_TYPE = 'FDA JOBS'
GROUP BY FHDR.DOC_REF,TO_CHAR(HDR.TRANSACTION_DATE,'DD-MON-YYYY')

UNION ALL
SELECT TO_CHAR(HDR.TRANSACTION_DATE,'DD-MON-YYYY') TT_DATE, 'REF NO' ||PHDR.DOC_REF REMARKS ,ROUND(
      SUM(NVL(BKID.PO_QTY,0)*NVL( BKID.PRICE,0)),3) AS DR_AMT,'DR' DRCRTYPE
FROM  GL_BANK_PAYMENT_ITEM_DTL BKID
INNER JOIN GL_BANK_DEBIT_HDR HDR       ON BKID.TRANSACTION_POID = HDR.TRANSACTION_POID
INNER JOIN AP_REQUEST_FOR_QTN_HDR PHDR ON HDR.SALES_QTN_REF     = PHDR.TRANSACTION_POID
WHERE BKID.TRANSACTION_POID                                     = $P{DOC_KEY_POID} AND HDR.REF_TYPE = 'MTA RFQ'
GROUP BY PHDR.DOC_REF,TO_CHAR(HDR.TRANSACTION_DATE,'DD-MON-YYYY')]]>
		</queryString>
		<field name="TT_DATE" class="java.lang.String"/>
		<field name="REMARKS" class="java.lang.String"/>
		<field name="DR_AMT" class="java.math.BigDecimal"/>
		<field name="DRCRTYPE" class="java.lang.String"/>
	</subDataset>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_DIV_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String"/>
	<parameter name="DOC_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select transaction_poid,doc_ref,BANK_DESCRIPTION bank,to_char(transaction_date,'DD-MON-YYYY')transaction_date,nvl(PAYING_TO_NAME,GL_DESCRIPTION) pay_to,long_narration,amount,
'Bahraini Dinar:'||' '||FN_AMOUNT_IN_WORDS_COMMON(amount,'BHD') AMOUNT_IN_WORD,hdr.CREATED_BY from gl_bank_debit_hdr hdr
INNER JOIN GL_MASTER MAST ON pay_gl_poid = MAST.GL_POID
inner join gl_bank_master bankmast on hdr.bank_poid =bankmast.bank_poid
where paying_type ='3'  and  transaction_poid = $P{DOC_KEY_POID} and REF_TYPE = 'GENERAL'
union all
select transaction_poid,doc_ref,BANK_DESCRIPTION bank,to_char(transaction_date,'DD-MON-YYYY')transaction_date, PAYING_TO_NAME pay_to,long_narration,amount,
'Bahraini Dinar:'||' '||FN_AMOUNT_IN_WORDS_COMMON(amount,'BHD') AMOUNT_IN_WORD,hdr.CREATED_BY from gl_bank_debit_hdr hdr
inner join gl_bank_master bankmast on hdr.bank_poid =bankmast.bank_poid
where paying_type ='3'  and  transaction_poid = $P{DOC_KEY_POID} and REF_TYPE != 'GENERAL']]>
	</queryString>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="DOC_REF" class="java.lang.String"/>
	<field name="BANK" class="java.lang.String"/>
	<field name="TRANSACTION_DATE" class="java.lang.String"/>
	<field name="PAY_TO" class="java.lang.String"/>
	<field name="LONG_NARRATION" class="java.lang.String"/>
	<field name="AMOUNT" class="java.math.BigDecimal"/>
	<field name="AMOUNT_IN_WORD" class="java.lang.String"/>
	<field name="CREATED_BY" class="java.lang.String"/>
