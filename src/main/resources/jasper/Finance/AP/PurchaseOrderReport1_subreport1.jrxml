    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <parameter name="P_TAX_APPLICABLE" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA['N']]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT TRANSACTION_POID, DET_ROW_ID, STOCK_NAME, STOCK_UNIT_CODE, QTY, PRICE, DISCOUNT, TAX_PERCENTAGE, SUB_TOTAL,
TAX_AMOUNT, NVL(SUB_TOTAL,0) + NVL(TAX_AMOUNT,0) AS TOTAL, REMARKS, CURRENCY_CODE
FROM(
SELECT TRANSACTION_POID, DET_ROW_ID, STOCK_NAME, STOCK_UNIT_CODE, QTY, PRICE, DISCOUNT, TAX_PERCENTAGE, SUB_TOTAL,
CASE WHEN ABS(NVL(CAL_TAX_AMOUNT,0)-NVL(TAX_AMOUNT,0))>0.010 THEN CAL_TAX_AMOUNT ELSE TAX_AMOUNT END AS TAX_AMOUNT, REMARKS, CURRENCY_CODE
FROM(
    SELECT APOD.TRANSACTION_POID, APOD.DET_ROW_ID,
    DECODE(POH.DESCRIPTION_PRINT_YN,'Y',(SM.STOCK_NAME||' '||APOD.REMARKS),APOD.REMARKS) AS STOCK_NAME, SU.STOCK_UNIT_CODE,
    APOD.QTY, APOD.PRICE, APOD.DISCOUNT, APOD.TAX_PERCENTAGE, NVL(APOD.QTY,0) * (NVL(APOD.PRICE,0) - NVL(APOD.DISCOUNT,0)) AS SUB_TOTAL,
    ROUND((NVL(APOD.QTY,0) * (NVL(APOD.PRICE,0) - NVL(APOD.DISCOUNT,0))) * (APOD.TAX_PERCENTAGE/100),3) AS CAL_TAX_AMOUNT,
    APOD.TAX_AMOUNT, APOD.REMARKS, POH.CURRENCY_CODE
    FROM AP_PURCHASE_ORDER_ITEM_DTL APOD
    LEFT JOIN AP_PURCHASE_ORDER_HDR POH ON POH.TRANSACTION_POID=APOD.TRANSACTION_POID
    LEFT JOIN STOCK_MASTER SM ON SM.STOCK_POID =APOD.STOCK_POID
    LEFT JOIN STOCK_UNIT_MASTER SU ON SU.STOCK_UNIT_POID=APOD.STOCK_UNIT_POID
    WHERE APOD.TRANSACTION_POID=$P{DOC_KEY_POID}
    )
    )
ORDER BY DET_ROW_ID]]>
    </queryString>
