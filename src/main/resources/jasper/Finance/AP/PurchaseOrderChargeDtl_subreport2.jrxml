    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT
POCD.TRANSACTION_POID,POCD.CHARGE_POID,SCM.CHARGE_NAME,POCD.CHARGE_AMOUNT,POCD.DESCRIPTION,POCD.REMARKS
FROM AP_PURCHASE_ORDER_CHARGE_DTL POCD
INNER  JOIN SHIP_CHARGE_MASTER SCM ON SCM.CHARGE_POID=POCD.CHARGE_POID
WHERE POCD.TRANSACTION_POID=$P{DOC_KEY_POID}]]>
    </queryString>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="CHARGE_POID" class="java.math.BigDecimal"/>
    <field name="CHARGE_NAME" class="java.lang.String"/>
    <field name="CHARGE_AMOUNT" class="java.math.BigDecimal"/>
    <field name="DESCRIPTION" class="java.lang.String"/>
    <field name="REMARKS" class="java.lang.String"/>
    <variable name="AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{CHARGE_AMOUNT}]]></variableExpression>
    </variable>
