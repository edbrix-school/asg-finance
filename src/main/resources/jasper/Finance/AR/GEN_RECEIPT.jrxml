    <field name="BUILDING" class="java.lang.String"/>
    <field name="STATE" class="java.lang.String"/>
    <field name="EMAIL" class="java.lang.String"/>
    <field name="OFFICE_TEL" class="java.lang.String"/>
    <field name="MOBILE" class="java.lang.String"/>
    <field name="YES_NO" class="java.lang.String"/>
    <field name="CREDIT_GL_ADDRESS" class="java.lang.String"/>
    <variable name="TOTALAMT" class="java.math.BigDecimal"/>
    <variable name="Address" class="java.lang.String">
        <initialValueExpression><![CDATA[(($F{PO_BOX} == null? "":"P. O. BOX :"+$F{PO_BOX}) + "\n" + ($F{OFFICE_TEL} == null ? "" :"Contact# :" +$F{OFFICE_TEL}+"/")+($F{MOBILE} == null ?"" :$F{MOBILE} ))]]></initialValueExpression>
    </variable>
