    <subDataset name="PayDetails" uuid="a6f0ed3d-495c-4189-ad01-6a77a3cab81a">
        <parameter name="DOC_KEY_POID" class="java.lang.String"/>
        <queryString>
            <![CDATA[SELECT DISTINCT
            DOCUMENT_NO,DOCUMENT_DATE,AMOUNT,CRDR_TYPE
      FROM
            (SELECT
                        PHDR.DOC_REF DOCUMENT_NO,TO_CHAR(PHDR.TRANSACTION_DATE,'DD-MON-YYYY') DOCUMENT_DATE, ROUND(SUM(NVL(BKID.PO_QTY,0)*NVL(
                        BKID.PRICE,0)),3) AS AMOUNT,'Dr' CRDR_TYPE
                  FROM
                        GL_BANK_PAYMENT_ITEM_DTL BKID
                  INNER JOIN GL_BANK_PAYMENT_HDR HDR    ON BKID.TRANSACTION_POID = HDR.TRANSACTION_POID
                  INNER JOIN AP_PURCHASE_ORDER_HDR PHDR ON HDR.PO_REF            = PHDR.TRANSACTION_POID
                  WHERE
                        BKID.TRANSACTION_POID= $P{DOC_KEY_POID} AND HDR.REF_TYPE = 'GENERAL PO'
                  GROUP BY
                        PHDR.DOC_REF,TO_CHAR(PHDR.TRANSACTION_DATE,'DD-MON-YYYY')
            UNION ALL
            SELECT
                        PHDR.DOC_REF DOCUMENT_NO,TO_CHAR(PHDR.TRANSACTION_DATE,'DD-MON-YYYY') DOCUMENT_DATE, ROUND(SUM(NVL(BKID.PO_QTY,0)*NVL(
                        BKID.PRICE,0)),3) AS AMOUNT,'Dr' CRDR_TYPE
                  FROM
                        GL_BANK_PAYMENT_ITEM_DTL BKID
                  INNER JOIN GL_BANK_PAYMENT_HDR HDR     ON BKID.TRANSACTION_POID = HDR.TRANSACTION_POID
                  INNER JOIN AP_REQUEST_FOR_QTN_HDR PHDR ON HDR.SALES_QTN_REF     = PHDR.TRANSACTION_POID
                  WHERE
                        BKID.TRANSACTION_POID= $P{DOC_KEY_POID} AND HDR.REF_TYPE = 'MTA RFQ'
                  GROUP BY
                        PHDR.DOC_REF,TO_CHAR(PHDR.TRANSACTION_DATE,'DD-MON-YYYY')
            UNION ALL
            SELECT
                        FHDR.DOC_REF DOCUMENT_NO ,TO_CHAR(FHDR.TRANSACTION_DATE,'DD-MON-YYYY') DOCUMENT_DATE ,SUM(CHARGE_AMOUNT) AS AMOUNT,'Dr'
                        CRDR_TYPE
                  FROM
                        GL_BANK_PAYMENT_CHARGE_DTL BKID
                  INNER JOIN GL_BANK_PAYMENT_HDR HDR ON BKID.TRANSACTION_POID = HDR.TRANSACTION_POID
                  INNER JOIN FF_MANIEST_HDR FHDR     ON BKID.REF_DOC_POID     = FHDR.TRANSACTION_POID
                  WHERE
                        BKID.TRANSACTION_POID= $P{DOC_KEY_POID} AND HDR.REF_TYPE = 'FF JOBS'
                  GROUP BY
                        FHDR.DOC_REF,TO_CHAR(FHDR.TRANSACTION_DATE,'DD-MON-YYYY')
            UNION ALL
            SELECT
                        FHDR.DOC_REF DOCUMENT_NO ,TO_CHAR(HDR.TRANSACTION_DATE,'DD-MON-YYYY') DOCUMENT_DATE ,SUM(BKID.CHARGE_AMOUNT) AMOUNT,'Dr'
                        CRDR_TYPE
                  FROM
                        GL_BANK_PAYMENT_CHARGE_DTL BKID
                  INNER JOIN GL_BANK_PAYMENT_HDR HDR ON BKID.TRANSACTION_POID = HDR.TRANSACTION_POID
                  INNER JOIN PDA_FDA_HDR FHDR        ON HDR.FDA_REF           = FHDR.TRANSACTION_POID
                  WHERE
                        BKID.TRANSACTION_POID= $P{DOC_KEY_POID} AND HDR.REF_TYPE = 'FDA JOBS'
                  GROUP BY
                        FHDR.DOC_REF,TO_CHAR(HDR.TRANSACTION_DATE,'DD-MON-YYYY')
            UNION ALL
            SELECT
                        BRKUP.BILL_REF DOCUMENT_NO ,TO_CHAR(GLB1.BILL_DUE_DATE,'DD-MON-YYYY') DOCUMENT_DATE ,NVL(SUM(DR_AMT),SUM(NVL(CR_AMT,0)))
                        AMOUNT,DECODE(SUM(DR_AMT),NULL,'Cr',0,'Cr','Dr') CRDR_TYPE
                  FROM
                        GL_BANK_PAYMENT_HDR BHDR
                  INNER JOIN GL_VOUCHER_BILL_BREAKUP_DTL BRKUP ON BHDR.TRANSACTION_POID = BRKUP.TRANSACTION_POID AND DOC_ID = '400-107'
                  LEFT JOIN
                        (
                        SELECT GL_POID, BILL_REF, MIN(BILL_DUE_DATE) as BILL_DUE_DATE
                        FROM Gl_Ledger_Billwise_Breakup
                        WHERE BILL_REF_TYPE IN ('NEW', 'ON-ACCOUNT') AND BILL_DUE_DATE IS NOT NULL
                        GROUP BY GL_POID, BILL_REF) GLB1 ON BRKUP.GL_POID  = GLB1.GL_POID AND BRKUP.BILL_REF = GLB1.BILL_REF
                  WHERE
                        BHDR.TRANSACTION_POID = $P{DOC_KEY_POID}   AND BHDR.REF_TYPE='GENERAL'
                  GROUP BY
                        BRKUP.BILL_REF,TO_CHAR(GLB1.BILL_DUE_DATE,'DD-MON-YYYY')
            UNION ALL
            SELECT
                        DTL.REMARKS DOCUMENT_NO,TO_CHAR(CHQ_DATE,'DD-MON-YYYY') DOCUMENT_DATE,CURRENCY_AMOUNT AMOUNT,type CRDR_TYPE
                  FROM
                        GL_BANK_PAYMENT_HDR HDR
                  INNER JOIN GL_BANK_PAYMENT_DTL_GL DTL ON HDR.TRANSACTION_POID = DTL.TRANSACTION_POID
                  WHERE
                        HDR.TRANSACTION_POID = $P{DOC_KEY_POID}   AND HDR.REF_TYPE='GENERAL'   AND DTL.REMARKS IS NOT NULL
            )
      ORDER BY
            DOCUMENT_NO]]>
        </queryString>
        <field name="DOCUMENT_NO" class="java.lang.String"/>
        <field name="DOCUMENT_DATE" class="java.lang.String"/>
        <field name="AMOUNT" class="java.math.BigDecimal"/>
        <field name="CRDR_TYPE" class="java.lang.String"/>
    </subDataset>
    <parameter name="LOGIN_GROUP_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_COMP_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
