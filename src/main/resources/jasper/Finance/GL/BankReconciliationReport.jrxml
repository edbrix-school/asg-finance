	<queryString>
		<![CDATA[SELECT  $P{DOC_FROM_DATE} AS FROM_DATE,$P{DOC_TO_DATE} AS TO_DATE, BM.BANK_DESCRIPTION AS BANK_NAME,
'Balance As'||' '||BM.BANK_DESCRIPTION||' '||'in Our Book' AS  BANK,
'Balance As'||' '||BM.BANK_DESCRIPTION||' '||'Bank Statement' AS  BANK_STATEMENT
FROM DUAL
INNER JOIN GL_BANK_MASTER BM ON BM.BANK_POID=$P{BANK_POID}]]>
	</queryString>
