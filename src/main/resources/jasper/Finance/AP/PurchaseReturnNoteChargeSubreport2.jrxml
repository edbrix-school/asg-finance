    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT
    PIC.TRANSACTION_POID, PIC.DET_ROW_ID,SCM.CHARGE_NAME, PIC.CHARGE_AMOUNT,
    PIC.DESCRIPTION, PIC.REMARKS, PIC.REF_DOC_ID, PIC.REF_DOC_POID
  FROM
    AP_PURCHASE_INVOICE_CHARGE_DTL PIC
  LEFT JOIN SHIP_CHARGE_MASTER SCM
  ON
    SCM.CHARGE_POID=PIC.CHARGE_POID
WHERE PIC.TRANSACTION_POID=$P{DOC_KEY_POID}]]>
    </queryString>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="DET_ROW_ID" class="java.math.BigDecimal"/>
    <field name="CHARGE_NAME" class="java.lang.String"/>
