    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[select DTL.BILL_REF_TYPE, DTL.BILL_REFNO, DTL.BILL_DUE_DATE, DTL.AMOUNT,
DECODE(DTL.CR_DR_TYPE,'DEBIT','Dr','Cr') as CR_DR_TYPE,
case when DTL.CR_DR_TYPE LIKE 'DEBIT' then DTL.AMOUNT*-1 else DTL.AMOUNT end as AMOUNT_WITH_SIGN
from AR_GEN_RECEIPT_BILL_DTL DTL
INNER JOIN AR_GEN_RECEIPT_HDR HDR ON HDR.TRANSACTION_POID=DTL.TRANSACTION_POID
WHERE DTL.CHECKALL='Y' AND DTL.TRANSACTION_POID=$P{DOC_KEY_POID}]]>
    </queryString>
    <field name="BILL_REF_TYPE" class="java.lang.String"/>
    <field name="BILL_REFNO" class="java.lang.String"/>
    <field name="BILL_DUE_DATE" class="java.sql.Timestamp"/>
    <field name="AMOUNT" class="java.math.BigDecimal"/>
    <field name="CR_DR_TYPE" class="java.lang.String"/>
    <field name="AMOUNT_WITH_SIGN" class="java.math.BigDecimal"/>
    <variable name="TOTAL_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{AMOUNT_WITH_SIGN}]]></variableExpression>
    </variable>
