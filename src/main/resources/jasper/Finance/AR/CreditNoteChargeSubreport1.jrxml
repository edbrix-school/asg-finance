<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CreditNoteChargeSubreport1" language="groovy" pageWidth="530" pageHeight="802" columnWidth="530" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="64b5803d-5c48-48b4-b8bc-806ca0f68203">
    <property name="ireport.zoom" value="1.3310000000000008"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT  CNCD.TRANSACTION_POID, SCM.CHARGE_NAME, CNCD.CHARGE_AMOUNT,
CNCD.DESCRIPTION, CNCD.REMARKS, CNCD.CHECK_ALL,CNH.CURRENCY_CODE,
ROUND((CNCD.CHARGE_AMOUNT+NVL(CNCD.TAX_AMOUNT,0))/CNH.CURRENCY_RATE,2) AS USD,
CNH.REF_TYPE,
decode(CNH.REF_TYPE,'FF_INVOICE',1,0) REF_TYPE_CONDITION,
CASE WHEN GTM.TAX_CATEGORY = 'E' THEN 'E'  ELSE CAST(NVL(CNCD.TAX_PERCENTAGE,0 ) AS VARCHAR(10)) END  AS TAX_PERCENTAGE ,
NVL(CNCD.TAX_AMOUNT,0) AS TAX_AMOUNT,(CNCD.CHARGE_AMOUNT + +NVL(CNCD.TAX_AMOUNT,0)) AS ACTUAL_AMOUNT,
CASE WHEN  EXTRACT(YEAR FROM  CNH.TRANSACTION_DATE)>2018  THEN
RTN_GLOBAL_PARAMETER( 1,'GLOBAL_TAX_APPLICABLE','TAX',CNH.COMPANY_POID,NULL) ELSE 'N' END AS TAX_APPLICABLE
FROM
AR_CREDIT_NOTE_CHARGE_DTL CNCD
INNER JOIN AR_CREDIT_NOTE_HDR CNH
ON CNH.TRANSACTION_POID = CNCD.TRANSACTION_POID
LEFT JOIN SHIP_CHARGE_MASTER SCM
ON SCM.CHARGE_POID=CNCD.CHARGE_POID
LEFT JOIN GLOBAL_TAX_MASTER GTM
ON GTM.TAX_POID =  CNCD.TAX_POID
WHERE CNCD.TRANSACTION_POID=$P{DOC_KEY_POID}]]>
    </queryString>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="CHARGE_NAME" class="java.lang.String"/>
    <field name="CHARGE_AMOUNT" class="java.math.BigDecimal"/>
    <field name="DESCRIPTION" class="java.lang.String"/>
    <field name="REMARKS" class="java.lang.String"/>
    <field name="CHECK_ALL" class="java.lang.String"/>
    <field name="CURRENCY_CODE" class="java.lang.String"/>
    <field name="USD" class="java.math.BigDecimal"/>
    <field name="REF_TYPE" class="java.lang.String"/>
    <field name="REF_TYPE_CONDITION" class="java.math.BigDecimal"/>
    <field name="TAX_PERCENTAGE" class="java.lang.String"/>
    <field name="TAX_AMOUNT" class="java.math.BigDecimal"/>
    <field name="ACTUAL_AMOUNT" class="java.math.BigDecimal"/>
    <field name="TAX_APPLICABLE" class="java.lang.String"/>
    <variable name="TOTAL_TAX" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{TAX_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="TOTAL_EXCL_VAT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{CHARGE_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="RETURN_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[($F{CURRENCY_CODE}=="BHD") ? $F{ACTUAL_AMOUNT} : $F{USD}]]></variableExpression>
    </variable>
    <variable name="BHD_RETURN_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{ACTUAL_AMOUNT}]]></variableExpression>
    </variable>
