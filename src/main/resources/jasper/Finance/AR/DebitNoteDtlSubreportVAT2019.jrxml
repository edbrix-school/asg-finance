<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DebitNoteDtlSubreportVAT2019" language="groovy" pageWidth="530" pageHeight="802" columnWidth="530" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="c58cc137-8e6b-4988-bb20-80b67cd7b4f9">
    <property name="ireport.zoom" value="2.593742460100003"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT TRANSACTION_POID,TYPE,GL_DESCRIPTION,REMARKS,CURRENCY_CODE, SUM(CR_AMT) AS CR_AMT,
TAX_APPLICABLE, SUM(TAX_AMOUNT) AS TAX_AMOUNT, TAX_PERCENTAGE, SUM(TOTAL_AMOUNT) TOTAL_AMOUNT,
SUM(BHD_CHARGE_AMOUNT) AS BHD_CHARGE_AMOUNT, SUM(BHD_TAX_AMOUNT) AS BHD_TAX_AMOUNT, SUM(BHD_TOTAL_AMOUNT) AS BHD_TOTAL_AMOUNT

FROM
    (
    SELECT DND.TRANSACTION_POID, UPPER(DND.TYPE) AS TYPE, GM.GL_DESCRIPTION,
           NVL(DND.REMARKS,GM.GL_DESCRIPTION) AS REMARKS, DNH.CURRENCY_CODE,
            CASE WHEN DNH.CURRENCY_CODE='BHD' THEN NVL(DND.CR_AMT,0)
            ELSE ROUND(NVL(DND.CR_AMT,0)/DNH.CURRENCY_RATE,2)
            END AS CR_AMT,
            CASE WHEN (TRUNC(DNH.TRANSACTION_DATE)>=TRUNC(GCM.VAT_REGISTRATION_DATE) AND EXTRACT(YEAR FROM  DNH.TRANSACTION_DATE)>2018)  THEN
            RTN_GLOBAL_PARAMETER( 1,'GLOBAL_TAX_APPLICABLE','TAX',DNH.COMPANY_POID,NULL) ELSE 'N' END AS TAX_APPLICABLE,
            CASE WHEN DNH.CURRENCY_CODE='BHD' THEN NVL(DND.TAX_AMOUNT,0)
            ELSE ROUND(NVL(DND.TAX_AMOUNT,0)/DNH.CURRENCY_RATE,2)
            END AS TAX_AMOUNT,
            (DECODE(GTM.TAX_CATEGORY,'V',TO_CHAR(DND.TAX_PERCENTAGE),'Z','0',TAX_CATEGORY))  AS TAX_PERCENTAGE,
            CASE WHEN DNH.CURRENCY_CODE='BHD' THEN NVL(TOTAL_AMOUNT,DND.CR_AMT)
                ELSE ROUND(NVL(TOTAL_AMOUNT,DND.CR_AMT)/DNH.CURRENCY_RATE,2)
          END AS TOTAL_AMOUNT,
          NVL(DND.CR_AMT,0) AS BHD_CHARGE_AMOUNT,
          NVL(DND.TAX_AMOUNT,0) AS BHD_TAX_AMOUNT,
          NVL(TOTAL_AMOUNT,DND.CR_AMT) AS BHD_TOTAL_AMOUNT
    FROM AR_DEBIT_NOTE_DTL DND
    LEFT JOIN GL_MASTER GM ON GM.GL_POID=DND.GL_POID
    INNER JOIN AR_DEBIT_NOTE_HDR DNH ON DNH.TRANSACTION_POID = DND.TRANSACTION_POID
    LEFT JOIN GLOBAL_TAX_MASTER GTM ON GTM.TAX_POID =  nvl(DND.TAX_POID,61)
    LEFT JOIN GLOBAL_COMPANY_MASTER GCM ON DNH.COMPANY_POID=GCM.COMPANY_POID
    WHERE UPPER(DND.TYPE)='CR' AND DND.TRANSACTION_POID = $P{DOC_KEY_POID}
    )
GROUP BY TRANSACTION_POID,TYPE,GL_DESCRIPTION,REMARKS,CURRENCY_CODE,TAX_APPLICABLE, TAX_PERCENTAGE]]>
    </queryString>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="TYPE" class="java.lang.String"/>
    <field name="GL_DESCRIPTION" class="java.lang.String"/>
    <field name="REMARKS" class="java.lang.String"/>
    <field name="CURRENCY_CODE" class="java.lang.String"/>
    <field name="CR_AMT" class="java.math.BigDecimal"/>
    <field name="TAX_APPLICABLE" class="java.lang.String"/>
    <field name="TAX_AMOUNT" class="java.math.BigDecimal"/>
    <field name="TAX_PERCENTAGE" class="java.lang.String"/>
    <field name="TOTAL_AMOUNT" class="java.math.BigDecimal"/>
    <field name="BHD_CHARGE_AMOUNT" class="java.math.BigDecimal"/>
    <field name="BHD_TAX_AMOUNT" class="java.math.BigDecimal"/>
    <field name="BHD_TOTAL_AMOUNT" class="java.math.BigDecimal"/>
    <variable name="Total" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{CR_AMT}]]></variableExpression>
    </variable>
    <variable name="RETURN_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{BHD_TOTAL_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="BHD_RETURN_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{BHD_TOTAL_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="TOTAL_TAX" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{TAX_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="TOTAL_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{TOTAL_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="TOTAL_EXCL_VAT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{CR_AMT}]]></variableExpression>
    </variable>
    <variable name="BHD_TOTAL_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{BHD_TOTAL_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="BHD_TOTAL_TAX" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{BHD_TAX_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="BHD_TOTAL_EXCL_VAT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{BHD_CHARGE_AMOUNT}]]></variableExpression>
    </variable>
