    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT DJV.COMPANY_POID,
  DJV.TYPE,GM.GL_CODE,
  GM.GL_DESCRIPTION AS GL_NAME,
  DJV.DR_AMT,
  DJV.CR_AMT,
  DJV.REMARKS
FROM GL_JOURNAL_VOUCHER_DTL DJV
LEFT JOIN GL_MASTER GM
ON GM.GL_POID=DJV.GL_POID
WHERE TRANSACTION_POID=$P{DOC_KEY_POID}]]>
    </queryString>
    <field name="COMPANY_POID" class="java.math.BigDecimal"/>
    <field name="TYPE" class="java.lang.String"/>
