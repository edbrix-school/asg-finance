    <subDataset name="BillwiseDetail" uuid="dd44444c-27d6-4d0c-b595-783f0c2678b7">
        <parameter name="DOC_KEY_POID" class="java.lang.String" isForPrompting="false"/>
        <queryString>
            <![CDATA[SELECT CM.COMPANY_CODE, BRKUP.BILL_REF DOCUMENT_NO , TO_CHAR(BRKUP.BILL_DUE_DATE,'DD-MON-YYYY') DOCUMENT_DATE ,
       NVL(SUM(DR_AMT),SUM(NVL(CR_AMT,0))) AMOUNT,DECODE(SUM(DR_AMT),NULL,'Cr',0,'Cr','Dr') CRDR_TYPE
FROM GL_BANK_DEBIT_HDR BHDR
INNER JOIN GL_VOUCHER_BILL_BREAKUP_DTL BRKUP ON BHDR.TRANSACTION_POID = BRKUP.TRANSACTION_POID AND DOC_ID = '400-111'
INNER JOIN GLOBAL_COMPANY_MASTER CM ON BRKUP.GL_COMPANY_POID = CM.COMPANY_POID
LEFT JOIN(
         SELECT GL_POID, BILL_REF, MIN(BILL_DUE_DATE) AS BILL_DUE_DATE
         FROM  GL_LEDGER_BILLWISE_BREAKUP
         WHERE BILL_REF_TYPE IN ('NEW', 'ON-ACCOUNT') AND BILL_DUE_DATE IS NOT NULL
         GROUP BY GL_POID, BILL_REF
         )GLB1 ON BRKUP.GL_POID = GLB1.GL_POID AND BRKUP.BILL_REF = GLB1.BILL_REF
WHERE BHDR.TRANSACTION_POID = $P{DOC_KEY_POID} AND BRKUP.GL_POID!=24422
GROUP BY BRKUP.BILL_REF, BRKUP.BILL_DUE_DATE, CM.COMPANY_CODE
ORDER BY CM.COMPANY_CODE, BRKUP.BILL_DUE_DATE]]>
        </queryString>
        <field name="COMPANY_CODE" class="java.lang.String"/>
        <field name="DOCUMENT_NO" class="java.lang.String"/>
        <field name="DOCUMENT_DATE" class="java.lang.String"/>
        <field name="AMOUNT" class="java.math.BigDecimal"/>
        <field name="CRDR_TYPE" class="java.lang.String"/>
        <variable name="TotAmount" class="java.math.BigDecimal" resetType="Group" resetGroup="group1" calculation="Sum">
            <variableExpression><![CDATA[$F{AMOUNT}]]></variableExpression>
            <initialValueExpression><![CDATA[]]></initialValueExpression>
        </variable>
        <group name="group1">
            <groupExpression><![CDATA[$F{COMPANY_CODE}]]></groupExpression>
        </group>
    </subDataset>
    <subDataset name="Total_amt" uuid="a5a41562-becc-4e5a-a7c7-f44ecc492d48">
        <parameter name="DOC_KEY_POID" class="java.lang.String"/>
        <queryString>
            <![CDATA[SELECT SUM(NVL(DR_AMT,0))-SUM(NVL(CR_AMT,0)) TOTAL_AMT
FROM GL_BANK_DEBIT_HDR BHDR
INNER JOIN GL_VOUCHER_BILL_BREAKUP_DTL BRKUP ON BHDR.TRANSACTION_POID = BRKUP.TRANSACTION_POID AND DOC_ID = '400-111'
LEFT JOIN(
          SELECT GL_POID, BILL_REF, MIN(BILL_DUE_DATE) as BILL_DUE_DATE
          FROM GL_LEDGER_BILLWISE_BREAKUP
          WHERE BILL_REF_TYPE IN ('NEW','ON-ACCOUNT') AND BILL_DUE_DATE IS NOT NULL
          GROUP BY GL_POID, BILL_REF
         )
        GLB1 ON BRKUP.GL_POID  = GLB1.GL_POID AND BRKUP.BILL_REF = GLB1.BILL_REF
WHERE BHDR.TRANSACTION_POID = $P{DOC_KEY_POID} AND BRKUP.GL_POID!=24422]]>
        </queryString>
        <field name="TOTAL_AMT" class="java.math.BigDecimal"/>
    </subDataset>
    <subDataset name="AmountInWord" uuid="26abf9c9-bb2c-4706-9c10-fcfd714ad62d">
        <parameter name="DOC_KEY_POID" class="java.lang.String"/>
        <queryString>
            <![CDATA[SELECT FN_AMOUNT_IN_WORDS_COMMON(SUM(NVL(DR_AMT,0))-SUM(NVL(CR_AMT,0)),'BHD') AS AMOUNT_IN_WORD
FROM GL_BANK_DEBIT_HDR BHDR
INNER JOIN GL_VOUCHER_BILL_BREAKUP_DTL BRKUP ON BHDR.TRANSACTION_POID = BRKUP.TRANSACTION_POID AND DOC_ID = '400-111'
LEFT JOIN(
        SELECT GL_POID, BILL_REF, MIN(BILL_DUE_DATE) as BILL_DUE_DATE
        FROM GL_LEDGER_BILLWISE_BREAKUP
        WHERE BILL_REF_TYPE IN ('NEW', 'ON-ACCOUNT') AND BILL_DUE_DATE IS NOT NULL
        GROUP BY GL_POID, BILL_REF
        )GLB1 ON BRKUP.GL_POID  = GLB1.GL_POID AND BRKUP.BILL_REF = GLB1.BILL_REF
WHERE BHDR.TRANSACTION_POID = $P{DOC_KEY_POID} AND BRKUP.GL_POID!=24422]]>
        </queryString>
        <field name="AMOUNT_IN_WORD" class="java.lang.String"/>
    </subDataset>
    <parameter name="LOGIN_GROUP_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_COMP_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_USER_POID" class="java.lang.String"/>
    <parameter name="DOC_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
    </parameter>
    <parameter name="DOC_KEY_POID" class="java.lang.String"/>
    <parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUB_FOOTER" class="net.sf.jasperreports.engine.JasperReport"/>
    <queryString>
        <![CDATA[select doc_ref,transaction_date,GL_DESCRIPTION paying_to,hdr.created_by,hdr.company_poid
                     from GL_BANK_debit_HDR hdr
                     inner join gl_master glmast on hdr.PAY_GL_POID = glmast.gl_poid
                     WHERE
                        HDR.TRANSACTION_POID = $P{DOC_KEY_POID}]]>
    </queryString>
    <field name="DOC_REF" class="java.lang.String"/>
    <field name="TRANSACTION_DATE" class="java.sql.Timestamp"/>
    <field name="PAYING_TO" class="java.lang.String"/>
    <field name="CREATED_BY" class="java.lang.String"/>
    <field name="COMPANY_POID" class="java.math.BigDecimal"/>
