	</variable>
	<variable name="DIFFERENCE" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{RETURN_DR_AMOUNT}.add($V{RETURN_CR_TOTAL}).subtract($V{RETURN_DR_TOTAL})]]></variableExpression>
	</variable>
