    </style>
    <parameter name="LOGIN_GROUP_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_COMP_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_USER_POID" class="java.lang.String"/>
    <parameter name="DOC_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
    </parameter>
    <parameter name="DOC_KEY_POID" class="java.lang.Long"/>
    <parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT 'User Rights - ' || R.USER_ROLE_NAME AS USER_ROLE_TITLE,
                 R.USER_ROLE_NAME,
                 (SELECT LISTAGG(U.USER_NAME, ', ') WITHIN GROUP (ORDER BY U.USER_NAME)
                  FROM GLOBAL_USERS U
                  JOIN GLOBAL_USERS_AUTH_ROLES_DTL UR ON U.USER_POID = UR.USER_POID
                  WHERE UR.USER_ROLE_POID = $P{DOC_KEY_POID} AND U.ACTIVE = 'Y') AS USER_LIST
                 FROM GLOBAL_USER_ROLES R
                 WHERE R.USER_ROLE_POID = $P{DOC_KEY_POID}]]>
    </queryString>
    <field name="USER_ROLE_TITLE" class="java.lang.String"/>
    <field name="USER_ROLE_NAME" class="java.lang.String"/>
    <field name="USER_LIST" class="java.lang.String"/>
    <background>
        <band splitType="Stretch"/>
    </background>
    <title>
