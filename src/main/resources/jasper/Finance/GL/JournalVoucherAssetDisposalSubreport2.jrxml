    <field name="ASSET_VALUE" class="java.math.BigDecimal"/>
    <field name="DEPRECIATED_AMT" class="java.math.BigDecimal"/>
    <field name="WDV_VALUE" class="java.math.BigDecimal"/>
    <field name="PROCESS" class="java.lang.String"/>
    <field name="SCRAP_SOLD_VALUE" class="java.math.BigDecimal"/>
    <field name="REMARKS" class="java.lang.String"/>
    <variable name="SCRAP_VALUE" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{SCRAP_SOLD_VALUE}]]></variableExpression>
    </variable>
    <variable name="GROSS_BLOCK" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{ASSET_VALUE}]]></variableExpression>
    </variable>
    <variable name="WDV_VALUE" class="java.math.BigDecimal" calculation="Sum">
