    <parameter name="DOC_KEY_ID_DTL" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[select GET_GL_NAME(DTL.GL_POID) GLNAME,DTL.BILL_REF_TYPE,DTL.BILL_REFNO,DTL.BILL_DUE_DATE,DTL.AMOUNT,
DECODE(DTL.CR_DR_TYPE,'DEBIT','Dr','Cr')CR_DR_TYPE ,NVL(HDR.ROUND_OFF,0)ROUNDOFF,NVL(HDR.BANK_CHARGES,0)BANK_CHARGES,
NVL(HDR.EX_GAIN_LOSS,0)EX_GAIN_LOSS,NVL(HDR.RCPT_AMOUNT,0)+ NVL(HDR.BANK_CHARGES,0)+
NVL(HDR.EX_GAIN_LOSS,0)+NVL(HDR.ROUND_OFF,0) TOTALS
from AR_GEN_RECEIPT_BILL_DTL DTL
INNER JOIN AR_GEN_RECEIPT_HDR HDR ON HDR.TRANSACTION_POID=DTL.TRANSACTION_POID
WHERE DTL.CHECKALL='Y' AND DTL.TRANSACTION_POID=$P{DOC_KEY_ID_DTL}]]>
    </queryString>
    <field name="GLNAME" class="java.lang.String"/>
    <field name="BILL_REF_TYPE" class="java.lang.String"/>
    <field name="BILL_REFNO" class="java.lang.String"/>
    <field name="BILL_DUE_DATE" class="java.sql.Timestamp"/>
    <field name="AMOUNT" class="java.math.BigDecimal"/>
    <field name="CR_DR_TYPE" class="java.lang.String"/>
    <field name="ROUNDOFF" class="java.math.BigDecimal"/>
    <field name="BANK_CHARGES" class="java.math.BigDecimal"/>
    <field name="EX_GAIN_LOSS" class="java.math.BigDecimal"/>
    <field name="TOTALS" class="java.math.BigDecimal"/>
    <variable name="AMOUNT_1" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{AMOUNT}]]></variableExpression>
    </variable>
