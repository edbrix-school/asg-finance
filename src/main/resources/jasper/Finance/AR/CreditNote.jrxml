    <queryString>
        <![CDATA[SELECT CNH.TRANSACTION_DATE,CNH.DOC_REF,CNH.PARTY_TYPE,CNH.REF_TYPE,CNH.FDA_REF,
CNH.CURRENCY_CODE AS CURRENCY_CODE,CNH.CURRENCY_RATE,CNH.POSTING_NARRATION,CNH.REMARKS,
GET_COMPANY_NAME(CNH.COMPANY_POID) AS COMPANY,CNH.GRAND_TOTAL,CNH.DUE_DATE,
ROUND(CNH.GRAND_TOTAL/CNH.CURRENCY_RATE,2) AS TOTAL_USD,CNH.COMPANY_POID,
NVL(DECODE(CNH.PRINT_COMPANY_POID,100,1,101,1,CNH.PRINT_COMPANY_POID),CNH.COMPANY_POID) AS PRINT_COMPANY_POID,
DECODE(CNH.PRINT_COMPANY_POID,100,5,101,2,1) AS COMP_DIV_POID,
CASE
  WHEN CNH.REF_TYPE= 'VOYAGE' THEN TO_CHAR(SVH.DOC_REF)
  WHEN CNH.REF_TYPE= 'FDA' THEN TO_CHAR(PFH.DOC_REF)
  WHEN CNH.REF_TYPE= 'FF' THEN TO_CHAR(FMH.DOC_REF)
  WHEN CNH.REF_TYPE= 'SH_INVOICE' THEN TO_CHAR(SSI.DOC_REF)
  WHEN CNH.REF_TYPE= 'DN_INVOICE' THEN TO_CHAR(DNH.DOC_REF)
  WHEN CNH.REF_TYPE= 'FF_INVOICE' THEN TO_CHAR(FSI.DOC_REF)
  WHEN CNH.REF_TYPE= 'MTA_INVOICE' THEN TO_CHAR(SCHH.DOC_REF)
END AS DOC_REF_TYPE,
CASE WHEN CNH.REF_TYPE= 'VOYAGE' OR CNH.REF_TYPE ='GENERAL' OR CNH.REF_TYPE ='CUSTOM' THEN SVH.ARRIVAL_DATE
     WHEN CNH.REF_TYPE= 'FDA' THEN PFH.ARRIVAL_DATE
     WHEN CNH.FDA_REF_POID IS NOT NULL THEN PFH.ARRIVAL_DATE
END AS ARRIVAL_DATE,
CASE WHEN CNH.REF_TYPE= 'VOYAGE' OR CNH.REF_TYPE ='GENERAL'  OR CNH.REF_TYPE ='CUSTOM' THEN SVH.SAIL_DATE
     WHEN CNH.REF_TYPE= 'FDA' THEN PFH.SAIL_DATE
     WHEN CNH.FDA_REF_POID IS NOT NULL THEN PFH.SAIL_DATE
END AS SAIL_DATE,
CASE WHEN CNH.REF_TYPE= 'VOYAGE' THEN SVM.VESSEL_NAME
     WHEN ((CNH.REF_TYPE= 'GENERAL' OR CNH.REF_TYPE ='CUSTOM') AND CNH.VOYAGE_REF IS NOT NULL) THEN SVM.VESSEL_NAME||'/'||SVH.VOYAGE_NO
     WHEN CNH.REF_TYPE= 'FDA' THEN SVM1.VESSEL_NAME
     WHEN CNH.FDA_REF_POID IS NOT NULL THEN SVM1.VESSEL_NAME
END AS VESSEL_NAME,
CASE
WHEN CNH.CURRENCY_CODE='USD' THEN
FN_AMOUNT_IN_WORDS_COMMON(ROUND(CNH.GRAND_TOTAL/CNH.CURRENCY_RATE,2),CNH.CURRENCY_CODE)
WHEN CNH.CURRENCY_CODE='BHD'
THEN FN_AMOUNT_IN_WORDS_COMMON(ROUND(CNH.GRAND_TOTAL/CNH.CURRENCY_RATE,3),CNH.CURRENCY_CODE)
END AS AMOUNT_IN_WORDS,
CASE
    WHEN CNH.PARTY_TYPE = 'SUPPLIER' THEN SM.SUPPLIER_NAME
    WHEN CNH.PARTY_TYPE = 'CUSTOMER'  THEN CM.CUSTOMER_NAME
    WHEN CNH.PARTY_TYPE = 'PRINCIPAL'  THEN SPM.PRINCIPAL_NAME
END AS PARTY_NAME,
--DECODE(CNH.REMARKS,null,null,'Remarks:'||CNH.REMARKS) REMARKS,
CASE WHEN CNH.PARTY_TYPE = 'SUPPLIER' THEN  SM.TIN_NUMBER
     WHEN CNH.PARTY_TYPE = 'CUSTOMER'  THEN CM.TIN_NUMBER
     WHEN CNH.PARTY_TYPE = 'PRINCIPAL'  THEN SPM.TIN_NUMBER
END AS PARTY_TIN_NUMBER,
DECODE(COMMAST.TIN_NUMBER ,null,null,COMMAST.TIN_NUMBER ) COMPANY_TIN_NUMBER,
CASE WHEN RTN_GLOBAL_PARAMETER( 1,'GLOBAL_TAX_APPLICABLE','TAX',CNH.COMPANY_POID,NULL) = 'Y'
AND (TRUNC(CNH.TRANSACTION_DATE)>=TRUNC(COMMAST.VAT_REGISTRATION_DATE) AND EXTRACT (YEAR FROM CNH.TRANSACTION_DATE)>2018)
THEN 'Y'
ELSE
'N'
END AS TAX_APPLICABLE, EXTRACT(YEAR FROM CNH.TRANSACTION_DATE) AS YEAR,
CASE WHEN (TRUNC(CNH.TRANSACTION_DATE)>=NVL(TRUNC(COMMAST.VAT_REGISTRATION_DATE),SYSDATE+1) AND EXTRACT(YEAR FROM CNH.TRANSACTION_DATE)>2018) AND RTN_GLOBAL_PARAMETER( 1,'GLOBAL_TAX_APPLICABLE','TAX',CNH.COMPANY_POID,NULL) = 'Y' THEN 'TAX CREDIT NOTE'
     WHEN (TRUNC(CNH.TRANSACTION_DATE)<NVL(TRUNC(COMMAST.VAT_REGISTRATION_DATE),SYSDATE+1) AND EXTRACT(YEAR FROM CNH.TRANSACTION_DATE)>2018) THEN 'Credit Note'
     WHEN EXTRACT(YEAR FROM CNH.TRANSACTION_DATE)<=2018 THEN 'Credit Note' END AS CREDIT_HEAD,
FN_FOR_CUSTOMER_ADDRESS('000-001',  CNH.PARTY_POID, CNH.PARTY_TYPE) AS PARTY_ADDRESS,
CNH.BANK_POID, GBM.BANK_ADDRESS, GBM.SWIFT_CODE, GBM.IBAN, GBM.BANK_ACCOUNT_NO, GBM.REMARKS AS BANK_REMARKS
FROM AR_CREDIT_NOTE_HDR CNH
LEFT JOIN GLOBAL_COMPANY_MASTER COMMAST  ON COMMAST.COMPANY_POID = CNH.COMPANY_POID
LEFT JOIN AP_SUPPLIER_MASTER SM ON SM.SUPPLIER_POID = CNH.PARTY_POID
LEFT JOIN SALES_CUSTOMER_MASTER CM ON CM.CUSTOMER_POID = CNH.PARTY_POID
LEFT JOIN SHIP_PRINCIPAL_MASTER SPM ON SPM.PRINCIPAL_POID = CNH.PARTY_POID
LEFT JOIN SHIP_VOYAGE_HDR SVH ON SVH.TRANSACTION_POID = CNH.VOYAGE_REF
LEFT JOIN SHIP_VESSEL_MASTER SVM ON SVM.VESSEL_POID = SVH.VESSEL_POID
LEFT JOIN PDA_FDA_HDR PFH ON PFH.TRANSACTION_POID = NVL(CNH.FDA_REF,CNH.FDA_REF_POID)
LEFT JOIN SHIP_VESSEL_MASTER SVM1 ON SVM1.VESSEL_POID = PFH.VESSEL_POID
LEFT JOIN FF_MANIEST_HDR FMH ON FMH.TRANSACTION_POID = CNH.FF_REF
LEFT JOIN AR_SH_SALES_INVOICE_HDR SSI ON SSI.TRANSACTION_POID = CNH.SH_INVOICE_POID
LEFT JOIN AR_DEBIT_NOTE_HDR DNH ON DNH.TRANSACTION_POID = CNH.DN_INVOICE_POID
LEFT JOIN AR_FF_SALES_INVOICE_HDR FSI ON FSI.TRANSACTION_POID = CNH.FF_INVOICE_POID
LEFT JOIN AR_SCH_SALES_INVOICE_HDR SCHH ON CNH.MTA_INVOICE_POID = SCHH.TRANSACTION_POID
LEFT JOIN GL_BANK_MASTER GBM ON GBM.BANK_POID = CNH.BANK_POID
WHERE CNH.TRANSACTION_POID = $P{DOC_KEY_POID}]]>
    </queryString>
