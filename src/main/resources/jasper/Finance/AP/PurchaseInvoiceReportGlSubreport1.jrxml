<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PurchaseInvoiceReportGlSubreport1" language="groovy" pageWidth="542" pageHeight="802" columnWidth="542" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="b5a097cf-ebe4-4e33-8890-70fa8537ea6b">
	<property name="ireport.zoom" value="1.2100000000000002"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT COMPANY_POID, TYPE, GL_CODE, COMPANY_CODE, GL_DESCRIPTION, DR_AMT, CR_AMT, REMARKS
FROM(
      SELECT PIG.COMPANY_POID, PIG.TYPE, GM.GL_CODE, GCM.COMPANY_CODE, GM.GL_DESCRIPTION,
      PIG.DR_AMOUNT AS DR_AMT, PIG.CR_AMOUNT AS CR_AMT, PIG.REMARKS
      FROM AP_PURCHASE_INVOICE_GL_DTL PIG
      LEFT JOIN GL_MASTER GM ON GM.GL_POID=PIG.GL_POID
      LEFT JOIN GLOBAL_COMPANY_MASTER GCM ON GCM.COMPANY_POID=PIG.COMPANY_POID
      WHERE TRANSACTION_POID=$P{DOC_KEY_POID}
      Union all
      SELECT PIG.COMPANY_POID, PIG.TYPE, GM.GL_CODE, GCM.COMPANY_CODE, GM.GL_DESCRIPTION,
      CASE WHEN PIG.TAX_AMOUNT>0 THEN PIG.TAX_AMOUNT END AS DR_AMT, CASE WHEN PIG.TAX_AMOUNT<0 THEN ABS(PIG.TAX_AMOUNT) END AS CR_AMT, PIG.REMARKS
      FROM AP_PURCHASE_INVOICE_GL_DTL PIG
      INNER JOIN GLOBAL_TAX_MASTER GTM ON GTM.TAX_POID=PIG.TAX_POID
      LEFT JOIN GL_MASTER GM ON GM.GL_POID=GTM.GL_POID
      LEFT JOIN GLOBAL_COMPANY_MASTER GCM ON GCM.COMPANY_POID=PIG.COMPANY_POID
      WHERE NVL(TAX_PERCENTAGE,0)>0 AND TRANSACTION_POID=$P{DOC_KEY_POID}
      )
ORDER BY TYPE DESC]]>
	</queryString>
	<field name="COMPANY_POID" class="java.math.BigDecimal"/>
	<field name="TYPE" class="java.lang.String"/>
	<field name="GL_CODE" class="java.lang.String"/>
	<field name="COMPANY_CODE" class="java.lang.String"/>
	<field name="GL_DESCRIPTION" class="java.lang.String"/>
	<field name="DR_AMT" class="java.math.BigDecimal"/>
	<field name="CR_AMT" class="java.math.BigDecimal"/>
	<field name="REMARKS" class="java.lang.String"/>
