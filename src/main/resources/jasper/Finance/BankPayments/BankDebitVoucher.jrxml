	<subDataset name="Special_instruction" uuid="bf8ed664-51fd-4350-9cf5-14e366d62135">
		<parameter name="DOC_KEY_POID" class="java.lang.String" isForPrompting="false"/>
		<parameter name="TT_REMARKS" class="java.math.BigDecimal"/>
		<queryString>
			<![CDATA[select CLAUSE_DETAILS from
 GLOBAL_TERMS_TEMPLATE_DTL dtl
WHERE  dtl.TERMS_POID = $P{TT_REMARKS}]]>
		</queryString>
		<field name="CLAUSE_DETAILS" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset1" uuid="8a4f6c86-9786-459c-a7f7-b0b3dd48e88d"/>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_DIV_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String"/>
	<parameter name="DOC_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT TO_CHAR(HDR.TRANSACTION_DATE,'DD-MON-YYYY') TRANSACTION_DATE, DECODE(PAYING_TYPE,'1','Telex Transfer','2','Direct Transfer','3','Credit card')
      SUB, DOC_REF,
      BMASTER.BANK_DESCRIPTION HDR_BANK_NAME,
      BMASTER.BANK_ACCOUNT_NO HDR_BANK_ACCOUNT,
      BMASTER.BANK_ADDRESS HDR_BANK_ADDRESS,
      NVL(NVL(NVL(DTL.BENEFICIARY_NAME,SDTL.BENEFICIARY_NAME),GMP.BENEFICIARY_NAME) , PAYING_TO_NAME) DTL_BENEFICIARY_NAME,
      NVL(NVL(DTL.ADDRESS,SDTL.ADDRESS),GMP.ADDRESS) DTL_BENEFICIARY_ADDR,
      NVL(NVL(NVL(DTL.ACCOUNT_NUMBER, SDTL.ACCOUNT_NUMBER),GMP.ACCOUNT_NUMBER), BENEFICIARY_IBAN) DTL_ACCOUNT_NUMBER,
      NVL(NVL(NVL(DTL.BANK,SDTL.BANK),GMP.BANK) , GBM.BANK_DESCRIPTION) DTL_BANK,
      NVL(NVL(NVL(DTL.IBAN,SDTL.IBAN),GMP.IBAN),BENEFICIARY_IBAN) DTL_IBAN,
      NVL(NVL(DTL.SWIFT_CODE,SDTL.SWIFT_CODE),GMP.SWIFT_CODE) DTL_BANK_SWIFT_CODE,
      NVL(NVL(DTL.BANK_ADDRESS,SDTL.BANK_ADDRESS),GMP.BANK_ADDRESS) DTL_BANK_ADDRESS,
      NVL(NVL(DTL.INTERMEDIARY_BANK,SDTL.INTERMEDIARY_BANK),GMP.INTERMEDIARY_BANK) DTL_INTERMEDIARY_BANK,
      NVL(NVL(DTL.INTERMEDIARY_ACCT,SDTL.INTERMEDIARY_ACCT),GMP.INTERMEDIARY_ACCT) DTL_INTERMEDIARY_ACCOUNT_BANK,
      NVL(NVL(DTL.BANK_SWIFT_CODE,SDTL.BANK_SWIFT_CODE),GMP.BANK_SWIFT_CODE) INTERMEDIARY_SWIFT_CODE,
      HDR.AMOUNT, HDR.CURRENCY_CODE,
      FN_AMOUNT_IN_WORDS_COMMON(HDR.AMOUNT,HDR.CURRENCY_CODE) AMOUNT_IN_WORD,
      FN_AMOUNT_IN_WORDS_COMMON(ROUND(NVL(HDR.CURRENCY_AMT, HDR.AMOUNT),CURRENCY_DECIMALS),
      HDR.CURRENCY_CODE) CURRENCY_AMOUNT_IN_WORD,
      TO_CHAR(HDR.TT_DATE,'DD-MON-YYYY') TT_DATE, CMAST.COMPANY_NAME, HDR.LONG_NARRATION
      REMITTANCE_DETAIL, NVL(NVL(DTL.SPECIAL_INSTRUCTION,SDTL.SPECIAL_INSTRUCTION),GMP.SPECIAL_INSTRUCTION) SPECIAL_INSTRUCTION, 'We hereby request you to do the '||DECODE(TRIM(
      PAYING_TYPE),'3','Credit card','1','Telex Transfer','2','Direct Transfer')||
      ' as detailed below. All the relevant charges can be debited to our above mention current account. Also send us Swift copy along with debit advice.'
      TEXT, HDR.PAYING_TYPE, NVL(HDR.CURRENCY_CODE,'BHD') CURRENCY_CODE, TRIM(TO_CHAR(ROUND( NVL(HDR.CURRENCY_AMT, HDR.AMOUNT),CURRENCY_DECIMALS),
      NUMBER_FORMAT_CURRENCY)) CURRENCY_AMT, TT_REMARK_POID, BPC.BANK_PURPOSE_CODE
FROM  GL_BANK_DEBIT_HDR HDR
INNER JOIN GL_BANK_MASTER BMASTER ON HDR.BANK_POID       = BMASTER.BANK_POID
LEFT JOIN SHIP_PRINCIPAL_MASTER_PYMT_DTL DTL ON DTL.BENEFICIARY_ID  = PAYING_TO
LEFT JOIN AP_SUPPLIER_MASTER_PYMT_DTL SDTL ON SDTL.BENEFICIARY_ID = PAYING_TO
LEFT JOIN GL_MASTER_PYMT_DTL GMP ON GMP.BENEFICIARY_ID = PAYING_TO
LEFT JOIN GLOBAL_COMPANY_MASTER CMAST ON HDR.COMPANY_POID    = CMAST.COMPANY_POID
LEFT JOIN GLOBAL_CURRENCY_MASTER CURR ON HDR.CURRENCY_CODE   = CURR.CURRENCY_CODE
LEFT JOIN GLOBAL_CUSTOMER_BANK_MASTER GBM ON HDR.BENEFICIARY_BANK_POID = GBM.BANK_POID
LEFT JOIN BANK_PURPOSE_CODE_MASTER BPC ON BPC.BANK_PURPOSE_POID = HDR.BANK_PURPOSE_POID
WHERE HDR.TRANSACTION_POID = $P{DOC_KEY_POID}]]>
	</queryString>
