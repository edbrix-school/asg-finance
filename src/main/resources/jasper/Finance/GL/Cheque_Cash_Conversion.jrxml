	<subDataset name="OutChequeDetails" uuid="9e0056ea-f360-42a4-93e3-fdc9e564b745">
		<parameter name="DOC_KEY_POID" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT VOUCHER_TYPE,CHQ_CARDNO,TO_CHAR(CHQ_DATE,'DD-MON-YYYY') AS  CHQ_DATE,CHQ_AC_NO,CHQ_AC_NAME,
BANK.BANK_DESCRIPTION,AMOUNT
FROM GL_CHEQUE_CASH_CONVERT_OUT_DTL DTL
LEFT JOIN GLOBAL_CUSTOMER_BANK_MASTER BANK ON DTL.BANK_POID = BANK.BANK_POID
WHERE TRANSACTION_POID = $P{DOC_KEY_POID}]]>
		</queryString>
		<field name="VOUCHER_TYPE" class="java.lang.String"/>
		<field name="CHQ_CARDNO" class="java.lang.String"/>
		<field name="CHQ_DATE" class="java.lang.String"/>
		<field name="CHQ_AC_NO" class="java.lang.String"/>
		<field name="CHQ_AC_NAME" class="java.lang.String"/>
		<field name="BANK_DESCRIPTION" class="java.lang.String"/>
		<field name="AMOUNT" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="InChequeDetails" uuid="db000767-1b59-4c5f-9210-4544414c4e1a">
		<parameter name="DOC_KEY_POID" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT VOUCHER_TYPE,CHQ_CARDNO,TO_CHAR(CHQ_DATE,'DD-MON-YYYY') AS CHQ_DATE,CHQ_AC_NAME,CHQ_AC_NO,BANK.BANK_DESCRIPTION,AMOUNT
FROM GL_CHEQUE_CASH_CONVERT_IN_DTL DTL
LEFT JOIN GLOBAL_CUSTOMER_BANK_MASTER BANK ON DTL.BANK_POID = BANK.BANK_POID
WHERE TRANSACTION_POID = $P{DOC_KEY_POID}]]>
		</queryString>
		<field name="VOUCHER_TYPE" class="java.lang.String"/>
		<field name="CHQ_CARDNO" class="java.lang.String"/>
		<field name="CHQ_DATE" class="java.lang.String"/>
		<field name="CHQ_AC_NO" class="java.lang.String"/>
		<field name="CHQ_AC_NAME" class="java.lang.String"/>
		<field name="BANK_DESCRIPTION" class="java.lang.String"/>
		<field name="AMOUNT" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="OutCashDetails" uuid="67bb5cb6-013b-4cac-9a0d-72f5e55ae150">
		<parameter name="DOC_KEY_POID" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[SELECT VOUCHER_TYPE,AMOUNT
FROM GL_CHEQUE_CASH_CONVERT_OUT_DTL DTL
WHERE TRANSACTION_POID = $P{DOC_KEY_POID}]]>
		</queryString>
		<field name="VOUCHER_TYPE" class="java.lang.String"/>
		<field name="AMOUNT" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="LOGIN_GROUP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String"/>
	<parameter name="LOGIN_DIV_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA["1"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SUB_FOOTER" class="net.sf.jasperreports.engine.JasperReport"/>
	<queryString>
		<![CDATA[SELECT COMPANY_POID,DOC_REF,CASH,
CASE WHEN TYPE='CHEQUE_TO_CASH' THEN 'CHEQUE'
     WHEN TYPE='CHEQUE_TO_CHEQUE' THEN 'CHEQUE'
     WHEN TYPE='CHEQUE_TO_IMCOCHEQUE' THEN 'CHEQUE'
     WHEN TYPE='CASH_TO_CHEQUE' THEN 'CASH'
     END AS OUT_DTL_TYPE,
CASE WHEN TYPE='CHEQUE_TO_CASH' THEN 'CASH'
     WHEN TYPE='CHEQUE_TO_CHEQUE' THEN 'CHEQUE'
     WHEN TYPE='CHEQUE_TO_IMCOCHEQUE' THEN 'CHEQUE'
     WHEN TYPE='CASH_TO_CHEQUE' THEN 'CHEQUE'
     END AS IN_DTL_TYPE,
CASE WHEN TYPE='CHEQUE_TO_CASH' AND NVL(ROUNDING_AMT,0)!=0 THEN 'ROUNDING_AMT'
     WHEN TYPE='CASH_TO_CHEQUE' AND NVL(ROUNDING_AMT,0)!=0 THEN 'ROUNDING_AMT'
     END AS ROUNDING_DTL,
CASE WHEN TYPE='CHEQUE_TO_CASH' AND NVL(CASH,0)!=0 THEN 'CASH_AMT'
     WHEN TYPE='CASH_TO_CHEQUE' AND NVL(CASH,0)!=0 THEN 'CASH_AMT'
     END AS CASH_DTL,
CASE WHEN TYPE='CHEQUE_TO_CASH' THEN 'Cheque To Cash Conversion'
     WHEN TYPE='CHEQUE_TO_CHEQUE' THEN 'Cheque To Cheque Conversion'
     WHEN TYPE='CHEQUE_TO_IMCOCHEQUE' THEN 'Cheque To IMCO Cheque Conversion'
     WHEN TYPE='CASH_TO_CHEQUE' THEN 'Cash To Cheque Conversion'
     END AS TYPE,TRANSACTION_DATE,ROUNDING_AMT
FROM GL_CHEQUE_CASH_CONVERT_HDR
WHERE TRANSACTION_POID = $P{DOC_KEY_POID}]]>
	</queryString>
	<field name="COMPANY_POID" class="java.math.BigDecimal"/>
	<field name="DOC_REF" class="java.lang.String"/>
	<field name="CASH" class="java.math.BigDecimal"/>
	<field name="OUT_DTL_TYPE" class="java.lang.String"/>
	<field name="IN_DTL_TYPE" class="java.lang.String"/>
	<field name="ROUNDING_DTL" class="java.lang.String"/>
	<field name="CASH_DTL" class="java.lang.String"/>
	<field name="TYPE" class="java.lang.String"/>
	<field name="TRANSACTION_DATE" class="java.sql.Timestamp"/>
	<field name="ROUNDING_AMT" class="java.math.BigDecimal"/>
	<variable name="Title" class="java.lang.String">
		<initialValueExpression><![CDATA[$F{TYPE}.contains("CHEQUE_TO_CHEQUE") ? "Cheque To Cheque Conversion": "Cheque To Cash Conversion"]]></initialValueExpression>
	</variable>
