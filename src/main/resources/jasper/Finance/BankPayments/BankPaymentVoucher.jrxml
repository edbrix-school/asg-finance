    <field name="PAYING_TO" class="java.lang.String"/>
    <field name="DOC_REF" class="java.lang.String"/>
    <field name="TRANSACTION_DATE" class="java.lang.String"/>
    <field name="CHQ_DATE" class="java.lang.String"/>
    <field name="CURRENCY_AMOUNT" class="java.math.BigDecimal"/>
    <field name="CHQ_DATE_FRT" class="java.lang.String"/>
    <field name="DATESTRING" class="java.lang.String"/>
    <field name="AMOUNT_IN_WORD" class="java.lang.String"/>
    <field name="REF_TYPE" class="java.lang.String"/>
    <field name="BANK_PREFIX" class="java.lang.String"/>
    <field name="LONG_NARRATION" class="java.lang.String"/>
