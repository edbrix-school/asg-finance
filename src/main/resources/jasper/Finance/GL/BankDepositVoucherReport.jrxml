	<queryString>
		<![CDATA[SELECT TRUNC(BDV.TRANSACTION_DATE) AS TRANSACTION_DATE,BDV.DOC_REF,BM.BANK_DESCRIPTION,BDV.CURRENCY_CODE,
BDV.CURRENCY_RATE,BDV.DR_TOTAL,BDV.CR_TOTAL,BDV.POSTING_NARRATION,BDV.REMARKS,BM.BANK_DESCRIPTION,BDV.REF_TYPE,
BDV.CREATED_BY
FROM GL_BANK_DEPOSIT_VOUCHER_HDR BDV
INNER JOIN GL_BANK_MASTER BM ON BM.GL_POID=BDV.BANK_POID
WHERE NVL(ACCOUNT_TYPE,'BANK')='BANK' AND NVL(BM.ACTIVE,'Y')='Y' AND BDV.TRANSACTION_POID=$P{DOC_KEY_POID}]]>
	</queryString>
