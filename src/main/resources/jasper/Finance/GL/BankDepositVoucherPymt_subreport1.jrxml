    <subDataset name="Amount In Words" uuid="037f7696-6703-40b1-847e-eb56fbb02060">
        <parameter name="TOTAL_AMT" class="java.math.BigDecimal"/>
        <queryString language="SQL">
            <![CDATA[SELECT FN_AMOUNT_IN_WORDS($P{TOTAL_AMT}) AS  AMOUNT_IN_WORDS FROM DUAL]]>
        </queryString>
        <field name="AMOUNT_IN_WORDS" class="java.lang.String"/>
    </subDataset>
    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[9]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT BDVD.CHQ_CARDNO,BDVD.CHQ_DATE,BDVD.AMOUNT,GCBM.BANK_CODE
FROM GL_BANK_DEPOSIT_VOUCHER_DTL BDVD
LEFT JOIN GLOBAL_CUSTOMER_BANK_MASTER GCBM
ON GCBM.BANK_POID=BDVD.BANK_POID
WHERE BDVD.TRANSACTION_POID=$P{DOC_KEY_POID}
order by nvl(CHQ_SEQ_NUM,0)]]>
    </queryString>
    <field name="CHQ_CARDNO" class="java.lang.String"/>
    <field name="CHQ_DATE" class="java.sql.Timestamp"/>
    <field name="AMOUNT" class="java.math.BigDecimal"/>
    <field name="BANK_CODE" class="java.lang.String"/>
    <variable name="TOTAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{AMOUNT}]]></variableExpression>
    </variable>
