    <queryString>
        <![CDATA[SELECT JV.TRANSACTION_POID,JV.TRANSACTION_DATE ,CM.COMPANY_NAME AS "COMPANY NAME",GCM.CURRENCY_NAME AS "CURRENCY NAME",JV.CURRENCY_RATE,JV.DOC_REF,
JV.DR_TOTAL,JV.CR_TOTAL,JV.POSTING_NARRATION,JV.REMARKS,JV.REF_TYPE
FROM GL_JOURNAL_VOUCHER_HDR JV
LEFT JOIN GLOBAL_COMPANY_MASTER CM
ON JV.COMPANY_POID=CM.COMPANY_POID
LEFT JOIN GLOBAL_CURRENCY_MASTER GCM
ON JV.CURRENCY_CODE=GCM.CURRENCY_CODE
WHERE TRANSACTION_POID=$P{DOC_KEY_POID}]]>
    </queryString>
