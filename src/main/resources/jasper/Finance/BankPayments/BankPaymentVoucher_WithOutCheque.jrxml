    <subDataset name="Detail_Table" uuid="6eda5f6a-2a11-40a7-be1b-ac5987ed64d3">
        <parameter name="DOC_KEY_POID" class="java.lang.String" isForPrompting="false">
            <defaultValueExpression><![CDATA[]]></defaultValueExpression>
        </parameter>
        <queryString>
            <![CDATA[SELECT BILL_REF as DOCUMENT_NO ,to_char(TRANSACTION_DATE,'DD-MON-YY') as DOCUMENT_DATE,
DECODE(DR_AMT,NULL,CR_AMT,0,CR_AMT,DR_AMT) as AMOUNT
FROM GL_LEDGER_BILLWISE_BREAKUP
WHERE DOC_ID = '400-107' AND  TRANSACTION_POID = $P{DOC_KEY_POID}]]>
        </queryString>
        <field name="DOCUMENT_NO" class="java.lang.String"/>
        <field name="DOCUMENT_DATE" class="java.lang.String"/>
        <field name="AMOUNT" class="java.math.BigDecimal"/>
    </subDataset>
    <parameter name="LOGIN_GROUP_POID" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_COMP_POID" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGIN_USER_POID" class="java.lang.String" isForPrompting="false"/>
    <parameter name="DOC_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA["000-000"]]></defaultValueExpression>
    </parameter>
    <parameter name="DOC_KEY_POID" class="java.lang.String"/>
    <parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
    </parameter>
    <parameter name="CHQ_SIGN_TYPE" class="java.lang.String"/>
    <queryString>
        <![CDATA[select distinct TRANSACTION_POID,paying_to,doc_ref,to_char(transaction_date,'DD-MON-YYYY') transaction_date,TO_CHAR(CHQ_DATE,'DD-MON-YYYY')CHQ_DATE,
CURRENCY_AMOUNT,REF_TYPE,'Cheque No.'||CHQ_CARDNO CURRENT_CHQ_NO,BANK_PREFIX,long_narration
FROM GL_BANK_PAYMENT_HDR HDR
INNER JOIN GL_BANK_MASTER BKHDR
ON HDR.BANK_POID = BKHDR.BANK_POID
WHERE TRANSACTION_POID = $P{DOC_KEY_POID}]]>
    </queryString>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="PAYING_TO" class="java.lang.String"/>
    <field name="DOC_REF" class="java.lang.String"/>
    <field name="TRANSACTION_DATE" class="java.lang.String"/>
    <field name="CHQ_DATE" class="java.lang.String"/>
    <field name="CURRENCY_AMOUNT" class="java.math.BigDecimal"/>
    <field name="REF_TYPE" class="java.lang.String"/>
    <field name="CURRENT_CHQ_NO" class="java.lang.String"/>
    <field name="BANK_PREFIX" class="java.lang.String"/>
    <field name="LONG_NARRATION" class="java.lang.String"/>
    <variable name="Remarks" class="java.lang.String">
        <variableExpression><![CDATA[$F{BANK_PREFIX}+" Cheque No:"+$F{CURRENT_CHQ_NO}+" Dated:"+$F{CHQ_DATE}+
" , "+$F{PAYING_TO}+" towards settlement of invoices"]]></variableExpression>
    </variable>
