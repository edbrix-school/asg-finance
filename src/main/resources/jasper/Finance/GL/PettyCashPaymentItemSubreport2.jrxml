    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT
    GPCC.TRANSACTION_POID, GPCC.DET_ROW_ID,SCM.CHARGE_NAME, GPCC.CHARGE_AMOUNT,
    GPCC.DESCRIPTION, GPCC.REMARKS, GPCC.REF_DOC_ID, GPCC.REF_DOC_POID
  FROM
   GL_PETTY_CASH_CHARGE_DTL GPCC
  LEFT JOIN SHIP_CHARGE_MASTER SCM
  ON
    SCM.CHARGE_POID=GPCC.CHARGE_POID
WHERE GPCC.TRANSACTION_POID=$P{DOC_KEY_POID}]]>
    </queryString>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="DET_ROW_ID" class="java.math.BigDecimal"/>
    <field name="CHARGE_NAME" class="java.lang.String"/>
    <field name="CHARGE_AMOUNT" class="java.math.BigDecimal"/>
    <field name="DESCRIPTION" class="java.lang.String"/>
    <field name="REMARKS" class="java.lang.String"/>
    <field name="REF_DOC_ID" class="java.lang.String"/>
    <field name="REF_DOC_POID" class="java.math.BigDecimal"/>
    <variable name="TOTAL_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{CHARGE_AMOUNT}]]></variableExpression>
    </variable>
