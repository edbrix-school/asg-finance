<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PettyCashPaymentItemSubreport1" language="groovy" pageWidth="530" pageHeight="802" columnWidth="530" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="04aae395-2f68-456d-8193-ebc82cfdf313">
    <property name="ireport.zoom" value="1.2100000000000009"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT GPCI.TRANSACTION_POID,
GPCI.DET_ROW_ID,
decode(RFQH.DESCRIPTION_PRINT_YN,'Y',(SM.STOCK_NAME||' '||GPCI.REMARKS),GPCI.REMARKS) AS STOCK_NAME,
SU.STOCK_UNIT_NAME,
GPCI.PO_QTY,
GPCI.PRICE,GPCI.PRICE*GPCI.PO_QTY AS TOTAL,
GPCI.DISCOUNT,
GPCI.REMARKS
FROM GL_PETTY_CASH_ITEM_DTL GPCI
  LEFT JOIN STOCK_MASTER SM
  ON
    SM.STOCK_POID =GPCI.STOCK_POID
  LEFT JOIN STOCK_UNIT_MASTER SU
  ON
    SU.STOCK_UNIT_POID=GPCI.STOCK_UNIT_POID
  INNER JOIN AP_REQUEST_FOR_QTN_HDR RFQH
  ON RFQH.TRANSACTION_POID = GPCI.REF_DOC_POID
WHERE GPCI.TRANSACTION_POID=$P{DOC_KEY_POID}]]>
    </queryString>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="DET_ROW_ID" class="java.math.BigDecimal"/>
    <field name="STOCK_NAME" class="java.lang.String"/>
    <field name="STOCK_UNIT_NAME" class="java.lang.String"/>
    <field name="PO_QTY" class="java.math.BigDecimal"/>
    <field name="PRICE" class="java.math.BigDecimal"/>
    <field name="TOTAL" class="java.math.BigDecimal"/>
    <field name="DISCOUNT" class="java.math.BigDecimal"/>
    <field name="REMARKS" class="java.lang.String"/>
    <variable name="ITEM_TOTAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{TOTAL}]]></variableExpression>
    </variable>
