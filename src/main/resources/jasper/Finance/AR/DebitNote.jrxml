    <subDataset name="AmountInWords" uuid="603444d5-0532-45b8-82ac-6f67ffa29e85">
        <parameter name="CURRENCY_CODE" class="java.lang.String"/>
        <parameter name="RETURN_AMOUNT" class="java.math.BigDecimal"/>
        <queryString language="SQL">
            <![CDATA[select FN_AMOUNT_IN_WORDS_common($P{RETURN_AMOUNT},$P{CURRENCY_CODE}) Amount_in_word,$P{CURRENCY_CODE} Currency_code from dual]]>
        </queryString>
        <field name="AMOUNT_IN_WORD" class="java.lang.String"/>
        <field name="CURRENCY_CODE" class="java.lang.String"/>
    </subDataset>
    <parameter name="LOGIN_GROUP_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
