    <parameter name="INVOICE_PRINT" class="java.lang.String">
        <defaultValueExpression><![CDATA["N"]]></defaultValueExpression>
    </parameter>
    <parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUB_FOOTER" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUB_DEBIT_DTL_1" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUB_DEBIT_DTL_VAT" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUB_CHARGE_1" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUB_CHARGE_VAT" class="net.sf.jasperreports.engine.JasperReport"/>
    <queryString>
        <![CDATA[

SELECT TO_CHAR(DNH.TRANSACTION_DATE, nvl(CM.INVOICE_DATE_FORMAT,'DD-MON-RRRR')) TRANSACTION_DATE, DNH.DOC_REF,DNH.PARTY_TYPE,DNH.REF_TYPE,DNH.FDA_REF,DNH.FF_REF,DNH.TDR_REF,
DNH.CURRENCY_CODE AS CURRENCY_CODE,DNH.CURRENCY_RATE,DNH.POSTING_NARRATION,DNH.BANK_POID,
NVL(DECODE(DNH.PRINT_COMPANY_POID,100,1,101,1,DNH.PRINT_COMPANY_POID),DNH.COMPANY_POID) AS PRINT_COMPANY_POID,
DECODE(DNH.PRINT_COMPANY_POID,100,5,101,2,1) AS COMP_DIV_POID, DNH.PRINT_DIVISION_POID,
DNH.PO_REF, DNH.USD_ONLY,
GET_COMPANY_OR_DIV_NAME(DNH.COMPANY_POID, NVL(PRINT_DIVISION_POID,1)) COMPANY,
DNH.PROPERTY_INVOICE, TO_CHAR(DUE_DATE, nvl(CM.INVOICE_DATE_FORMAT,'DD-MON-RRRR')) DUE_DATE,
CASE WHEN DNH.REF_TYPE= 'VOYAGE' THEN SVH.ARRIVAL_DATE
     WHEN DNH.REF_TYPE= 'GENERAL' or  DNH.REF_TYPE= 'CUSTOM'  THEN SVH.ARRIVAL_DATE
     WHEN DNH.REF_TYPE= 'FDA' THEN PFH.ARRIVAL_DATE
     WHEN DNH.REF_TYPE= 'FDA_DIRECT' THEN PFH1.ARRIVAL_DATE
END AS ARRIVAL_DATE,
CASE WHEN DNH.REF_TYPE= 'VOYAGE' THEN SVH.SAIL_DATE
     WHEN DNH.REF_TYPE= 'GENERAL'  or  DNH.REF_TYPE= 'CUSTOM' THEN SVH.SAIL_DATE
     WHEN DNH.REF_TYPE= 'FDA' THEN PFH.SAIL_DATE
     WHEN DNH.REF_TYPE= 'FDA_DIRECT' THEN PFH1.SAIL_DATE
END AS SAIL_DATE,
CASE WHEN DNH.REF_TYPE= 'VOYAGE' THEN SVM2.VESSEL_NAME||'/'||SVH.VOYAGE_NO
     WHEN DNH.REF_TYPE= 'GENERAL'  or  DNH.REF_TYPE= 'CUSTOM' THEN SVM2.VESSEL_NAME||'/'||SVH.VOYAGE_NO
     WHEN DNH.REF_TYPE= 'FDA' THEN SVM.VESSEL_NAME||'/'||PFH.VOYAGE_NO
     WHEN DNH.REF_TYPE= 'FDA_DIRECT' THEN SVM1.VESSEL_NAME||'/'||PFH1.VOYAGE_NO
END AS VESSEL_NAME,
ROUND(DNH.GRAND_TOTAL/DNH.CURRENCY_RATE,2) AS TOTAL_USD,
DNH.GRAND_TOTAL,
CASE WHEN DNH.REF_TYPE= 'VOYAGE' THEN TO_CHAR(SVH.DOC_REF)
     WHEN DNH.REF_TYPE= 'GENERAL'  or  DNH.REF_TYPE= 'CUSTOM' THEN TO_CHAR(SVH.DOC_REF)
     WHEN DNH.REF_TYPE= 'FDA' THEN TO_CHAR(PFH.DOC_REF)
     WHEN DNH.REF_TYPE= 'FDA_DIRECT' THEN TO_CHAR(PFH1.DOC_REF)
END AS DOC_REF_TYPE,
CASE WHEN DNH.CURRENCY_CODE!='BHD'
     THEN FN_AMOUNT_IN_WORDS_COMMON(ROUND(DNH.GRAND_TOTAL/DNH.CURRENCY_RATE,2),DNH.CURRENCY_CODE)
     WHEN DNH.CURRENCY_CODE='BHD'
     THEN FN_AMOUNT_IN_WORDS_COMMON(ROUND(DNH.GRAND_TOTAL/DNH.CURRENCY_RATE,3),DNH.CURRENCY_CODE)
END AS AMOUNT_IN_WORDS,
CASE WHEN DNH.PARTY_TYPE = 'SUPPLIER' THEN SM.SUPPLIER_NAME
     WHEN DNH.PARTY_TYPE = 'CUSTOMER'  THEN CM.CUSTOMER_NAME
     WHEN DNH.PARTY_TYPE = 'PRINCIPAL'  THEN SPM.PRINCIPAL_NAME
END AS PARTY_NAME,
decode(DNH.REMARKS,null,null,'Remarks:'||DNH.REMARKS) REMARKS,
CASE WHEN DNH.PARTY_TYPE = 'SUPPLIER' THEN  SM.TIN_NUMBER
     WHEN DNH.PARTY_TYPE = 'CUSTOMER'  THEN CM.TIN_NUMBER
     WHEN DNH.PARTY_TYPE = 'PRINCIPAL'  THEN SPM.TIN_NUMBER
END AS PARTY_TIN_NUMBER,
GCM.ADDRESS,GCM.COMPANY_NAME,GCMBM.COMPANY_NAME BANK_BEF_NAME, GBM.BANK_ADDRESS,GBM.SWIFT_CODE,GBM.IBAN,GBM.BANK_ACCOUNT_NO,GBM.REMARKS AS BANK_REMARKS,
DECODE(GCM.TIN_NUMBER ,null,null,GCM.TIN_NUMBER ) COMPANY_TIN_NUMBER,
CASE WHEN  (TRUNC(DNH.TRANSACTION_DATE)>=TRUNC(GCM.VAT_REGISTRATION_DATE) AND EXTRACT(YEAR FROM  DNH.TRANSACTION_DATE)>2018)  THEN
RTN_GLOBAL_PARAMETER( 1,'GLOBAL_TAX_APPLICABLE','TAX',DNH.COMPANY_POID,NULL) ELSE 'N' END AS TAX_APPLICABLE,
CASE WHEN (TRUNC(DNH.TRANSACTION_DATE)>=TRUNC(GCM.VAT_REGISTRATION_DATE) AND EXTRACT(YEAR FROM DNH.TRANSACTION_DATE)>2018) AND RTN_GLOBAL_PARAMETER( 1,'GLOBAL_TAX_APPLICABLE','TAX',DNH.COMPANY_POID,NULL) = 'Y' AND DNH.VOUCHER_TYPE='INVOICE' THEN 'TAX INVOICE'
     WHEN (TRUNC(DNH.TRANSACTION_DATE)>=TRUNC(GCM.VAT_REGISTRATION_DATE) AND EXTRACT(YEAR FROM DNH.TRANSACTION_DATE)>2018) AND RTN_GLOBAL_PARAMETER( 1,'GLOBAL_TAX_APPLICABLE','TAX',DNH.COMPANY_POID,NULL) = 'Y' AND DNH.VOUCHER_TYPE='DEBIT_NOTE' THEN 'TAX DEBIT NOTE'
     WHEN (TRUNC(DNH.TRANSACTION_DATE)<NVL(TRUNC(GCM.VAT_REGISTRATION_DATE),SYSDATE+1) AND EXTRACT(YEAR FROM DNH.TRANSACTION_DATE)>2018) AND DNH.VOUCHER_TYPE='INVOICE' THEN 'INVOICE'
     WHEN (TRUNC(DNH.TRANSACTION_DATE)<NVL(TRUNC(GCM.VAT_REGISTRATION_DATE),SYSDATE+1) AND EXTRACT(YEAR FROM DNH.TRANSACTION_DATE)>2018) AND DNH.VOUCHER_TYPE='DEBIT_NOTE' THEN 'DEBIT NOTE'
     WHEN EXTRACT(YEAR FROM DNH.TRANSACTION_DATE)<=2018 THEN 'INVOICE'
END AS INVOICE_HEAD,
CASE WHEN (TRUNC(DNH.TRANSACTION_DATE)>=TRUNC(GCM.VAT_REGISTRATION_DATE) AND EXTRACT(YEAR FROM DNH.TRANSACTION_DATE)>2018) AND RTN_GLOBAL_PARAMETER( 1,'GLOBAL_TAX_APPLICABLE','TAX',DNH.COMPANY_POID,NULL) = 'Y' AND DNH.VOUCHER_TYPE='INVOICE' THEN 'TAX INVOICE'
     WHEN (TRUNC(DNH.TRANSACTION_DATE)>=TRUNC(GCM.VAT_REGISTRATION_DATE) AND EXTRACT(YEAR FROM DNH.TRANSACTION_DATE)>2018) AND RTN_GLOBAL_PARAMETER( 1,'GLOBAL_TAX_APPLICABLE','TAX',DNH.COMPANY_POID,NULL) = 'Y' AND DNH.VOUCHER_TYPE='DEBIT_NOTE' THEN 'TAX DEBIT NOTE'
     WHEN (TRUNC(DNH.TRANSACTION_DATE)<NVL(TRUNC(GCM.VAT_REGISTRATION_DATE),SYSDATE+1) AND EXTRACT(YEAR FROM DNH.TRANSACTION_DATE)>2018) AND DNH.VOUCHER_TYPE='INVOICE' THEN 'INVOICE'
     WHEN (TRUNC(DNH.TRANSACTION_DATE)<NVL(TRUNC(GCM.VAT_REGISTRATION_DATE),SYSDATE+1) AND EXTRACT(YEAR FROM DNH.TRANSACTION_DATE)>2018) AND DNH.VOUCHER_TYPE='DEBIT_NOTE' THEN 'DEBIT NOTE'
     WHEN EXTRACT(YEAR FROM DNH.TRANSACTION_DATE)<=2018 THEN 'Debit Note'
END AS DEBIT_HEAD, TO_CHAR(EXTRACT(YEAR FROM DNH.TRANSACTION_DATE)) AS YEAR,
NVL(PARTY_REF, FN_FOR_CUSTOMER_ADDRESS('000-002',  DNH.PARTY_POID, DNH.PARTY_TYPE)) AS PARTY_ADDRESS, DNH.SHOW_BANK_DETAILS_IN_PRINT, COST_REF_NUMBER,
FUNC_SPECIAL_DATE_PARAMETERS(DNH.PARTY_POID) CUSTOMER_CONDITION
FROM AR_DEBIT_NOTE_HDR DNH
LEFT JOIN GLOBAL_COMPANY_MASTER GCM  ON GCM.COMPANY_POID=DNH.COMPANY_POID
LEFT JOIN AP_SUPPLIER_MASTER SM ON SM.SUPPLIER_POID=DNH.PARTY_POID
LEFT JOIN SALES_CUSTOMER_MASTER CM ON CM.CUSTOMER_POID=DNH.PARTY_POID
LEFT JOIN SHIP_PRINCIPAL_MASTER SPM ON SPM.PRINCIPAL_POID=DNH.PARTY_POID
LEFT JOIN PDA_FDA_HDR PFH ON PFH.TRANSACTION_POID=DNH.FDA_REF
LEFT JOIN PDA_FDA_HDR PFH1 ON PFH1.TRANSACTION_POID=DNH.FDA_DIRECT_REF
LEFT JOIN SHIP_VOYAGE_HDR SVH ON SVH.TRANSACTION_POID=DNH.VOYAGE_REF
LEFT JOIN SHIP_VESSEL_MASTER SVM ON SVM.VESSEL_POID=PFH.VESSEL_POID
LEFT JOIN SHIP_VESSEL_MASTER SVM1 ON SVM1.VESSEL_POID=PFH1.VESSEL_POID
LEFT JOIN SHIP_VESSEL_MASTER SVM2 ON SVM2.VESSEL_POID=SVH.VESSEL_POID
LEFT JOIN GL_BANK_MASTER GBM ON GBM.BANK_POID = DNH.BANK_POID
INNER JOIN GLOBAL_COMPANY_MASTER GCMBM ON GBM.COMPANY_POID = GCMBM.COMPANY_POID
WHERE DNH.TRANSACTION_POID=  $P{DOC_KEY_POID}]]>
    </queryString>
