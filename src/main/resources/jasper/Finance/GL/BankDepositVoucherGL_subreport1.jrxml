    <subDataset name="Amount In Words" uuid="f36acf5f-374a-4f68-b49b-afc809cd09a3">
        <parameter name="TOTAL_AMT" class="java.math.BigDecimal"/>
        <queryString language="SQL">
            <![CDATA[SELECT FN_AMOUNT_IN_WORDS($P{TOTAL_AMT}) AS  AMOUNT_IN_WORDS FROM DUAL]]>
        </queryString>
        <field name="AMOUNT_IN_WORDS" class="java.lang.String"/>
    </subDataset>
    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT SUM(BDVD.AMOUNT) AS AMOUNT
FROM GL_BANK_DEPOSIT_VOUCHER_DTL BDVD
WHERE BDVD.TRANSACTION_POID=$P{DOC_KEY_POID}
order by nvl(CHQ_SEQ_NUM,0)]]>
    </queryString>
    <field name="AMOUNT" class="java.math.BigDecimal"/>
