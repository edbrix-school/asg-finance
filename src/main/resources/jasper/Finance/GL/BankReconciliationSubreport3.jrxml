<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BankReconciliationSubreport3" language="groovy" pageWidth="530" pageHeight="802" columnWidth="530" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="2445681f-786b-44e2-a52e-3b0fe40fb1c4">
	<property name="ireport.zoom" value="1.6105100000000026"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="LOGIN_COM_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="BANK_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_FROM_DATE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="DOC_TO_DATE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT GL.TRANSACTION_GROUP_POID,GL.TRANSACTION_COMPANY_POID, GL.DOC_ID ,GL.TRANSACTION_POID, GL.TRANSACTION_DATE,
       GL.DOC_REF, GL.CHEQUE_REF, GL.DET_ROW_ID,GL.NARRATION, GL.GL_COMPANY_POID, GL.GL_POID, GL.CR_AMT, GL.DR_AMT,T.CLEARANCE_DATE
       FROM  GL_LEDGER GL
       LEFT JOIN( SELECT
                 GL.TRANSACTION_GROUP_POID,GL.TRANSACTION_COMPANY_POID, GL.DOC_ID , GL.GL_POID , GL.DOC_REF,
                 GL.TRANSACTION_POID,GL.TRANSACTION_DATE, GL.DET_ROW_ID, GL.GL_COMPANY_POID,GL.CLEARANCE_DATE
           FROM GL_BANK_RECONCILIATION_TABLE GL
           WHERE GL.GL_COMPANY_POID =$P{LOGIN_COM_POID} AND GL.GL_POID=(SELECT GL_POID FROM GL_BANK_MASTER WHERE BANK_POID=$P{BANK_POID})
                 )T ON GL.TRANSACTION_GROUP_POID=T.TRANSACTION_GROUP_POID AND
                       GL.TRANSACTION_COMPANY_POID=T.TRANSACTION_COMPANY_POID AND
                       GL.DOC_ID=T.DOC_ID AND
                       GL.GL_POID=T.GL_POID AND
                       GL.DOC_REF=T.DOC_REF AND
                       GL.TRANSACTION_POID=T.TRANSACTION_POID AND
                       GL.TRANSACTION_DATE=T.TRANSACTION_DATE AND
                       GL.DET_ROW_ID=T.DET_ROW_ID AND
                       GL.GL_COMPANY_POID=T.GL_COMPANY_POID
       WHERE ( GL.TRANSACTION_GROUP_POID,GL.TRANSACTION_COMPANY_POID, GL.DOC_ID , GL.GL_POID , GL.DOC_REF,
               GL.TRANSACTION_POID,GL.TRANSACTION_DATE, GL.DET_ROW_ID, GL.GL_COMPANY_POID
             ) IN
             (
               SELECT
                    GL.TRANSACTION_GROUP_POID,GL.TRANSACTION_COMPANY_POID, GL.DOC_ID , GL.GL_POID , GL.DOC_REF,
                    GL.TRANSACTION_POID,GL.TRANSACTION_DATE, GL.DET_ROW_ID, GL.GL_COMPANY_POID
               FROM GL_LEDGER GL
               WHERE GL.GL_COMPANY_POID =$P{LOGIN_COM_POID} AND GL.GL_POID=(SELECT GL_POID FROM GL_BANK_MASTER WHERE BANK_POID=$P{BANK_POID})
                           AND (TRUNC(GL.TRANSACTION_DATE) BETWEEN '01-JAN-2014' AND $P{DOC_TO_DATE})
               MINUS

               SELECT
                    GL.TRANSACTION_GROUP_POID,GL.TRANSACTION_COMPANY_POID, GL.DOC_ID , GL.GL_POID , GL.DOC_REF,
                    GL.TRANSACTION_POID,GL.TRANSACTION_DATE, DET_ROW_ID, GL_COMPANY_POID
                FROM GL_BANK_RECONCILIATION_TABLE GL
                WHERE GL.GL_COMPANY_POID =$P{LOGIN_COM_POID} AND GL.GL_POID=(SELECT GL_POID FROM GL_BANK_MASTER WHERE BANK_POID=$P{BANK_POID})
                      AND (TRUNC(GL.CLEARANCE_DATE)<= $P{DOC_TO_DATE})
              )
	    AND (NVL(GL.DR_AMT,0)!=0)
              ORDER BY GL.TRANSACTION_DATE]]>
	</queryString>
	<field name="TRANSACTION_GROUP_POID" class="java.math.BigDecimal"/>
	<field name="TRANSACTION_COMPANY_POID" class="java.math.BigDecimal"/>
	<field name="DOC_ID" class="java.lang.String"/>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="TRANSACTION_DATE" class="java.sql.Timestamp"/>
	<field name="DOC_REF" class="java.lang.String"/>
	<field name="CHEQUE_REF" class="java.lang.String"/>
	<field name="DET_ROW_ID" class="java.math.BigDecimal"/>
	<field name="NARRATION" class="java.lang.String"/>
	<field name="GL_COMPANY_POID" class="java.math.BigDecimal"/>
	<field name="GL_POID" class="java.math.BigDecimal"/>
	<field name="CR_AMT" class="java.math.BigDecimal"/>
	<field name="DR_AMT" class="java.math.BigDecimal"/>
	<field name="CLEARANCE_DATE" class="java.sql.Timestamp"/>
	<variable name="DR_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DR_AMT}]]></variableExpression>
	</variable>
