	<queryString>
		<![CDATA[SELECT
    RJH.TRANSACTION_POID, RJH.TRANSACTION_DATE, RJH.GROUP_POID,
    RJH.COMPANY_POID, RJH.DOC_REF, RJH.CURRENCY_CODE, RJH.CURRENCY_RATE,
    RJH.NARRATION, RJH.REFERENCE_NO, RJH.TOTAL_AMOUNT, RJH.START_DATE,
    RJH.NO_OF_MONTHS, RJH.REMARKS,RJH.TOTAL_AMOUNT/RJH.NO_OF_MONTHS AS MONTH_WISE_AMT
  FROM
    GL_RECURRING_JV_HDR RJH
WHERE RJH.TRANSACTION_POID=$P{DOC_KEY_POID}]]>
	</queryString>
