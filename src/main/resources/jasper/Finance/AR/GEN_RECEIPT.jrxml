    <queryString>
        <![CDATA[SELECT HDR.TRANSACTION_POID, HDR.TRANSACTION_DATE, GET_COMPANY_NAME(HDR.PRINT_DOC_COMP_ID) as COMPANY,
HDR.DOC_REF, HDR.PRINT_DOC_COMP_ID, HDR.COMPANY_POID, FUNC_FOR_GL_ADDRESS(HDR.RCVD_OTH_POID) AS CREDIT_GL_ADDRESS,
DECODE(HDR.RCVD_FROM_DTL_PRINT,NULL,GL.GL_DESCRIPTION,HDR.RCVD_FROM_DTL_PRINT) as RCVD_FROM,
GL.GL_DESCRIPTION, HDR.RCPT_AMOUNT, HDR.CREATED_BY, HDR.INVOICE_AMOUNT, HDR.REMARKS,
'Amount in words '||HDR.CURRENCY_CODE||' : '||FN_AMOUNT_IN_WORDS_COMMON( NVL(HDR.INVOICE_AMOUNT, 0), HDR.CURRENCY_CODE) as AMT_IN_WORDS,
HDR.CURRENCY_CODE, HDR.CURRENCY_RATE
FROM AR_GEN_RECEIPT_HDR HDR
INNER JOIN GL_MASTER GL ON GL.GL_POID=HDR.RCVD_OTH_POID
WHERE TRANSACTION_POID=$P{DOC_KEY_POID}]]>
    </queryString>
