<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PettyCashPaymentDtl_subreport1" language="groovy" pageWidth="530" pageHeight="802" columnWidth="530" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="0319529c-65c6-4237-91b6-37d0881a43d9">
    <property name="ireport.zoom" value="1.9487171000000025"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT TRANSACTION_POID, TYPE, COMPANY_POID, GL_DESCRIPTION,
CASE WHEN NVL(DR_AMT,0)!=0 THEN NVL(DR_AMT,0)
     WHEN NVL(CR_AMT,0)!=0 THEN NVL(CR_AMT,0)*-1 END AS AMOUNT, REMARKS
FROM(
    SELECT PCPD.TRANSACTION_POID, PCPD.TYPE, PCPD.COMPANY_POID, NVL(PCPD.REMARKS,GM.GL_DESCRIPTION) AS GL_DESCRIPTION,
    PCPD.DR_AMT, PCPD.CR_AMT, PCPD.REMARKS
    FROM GL_PETTY_CASH_PAYMENT_DTL PCPD
    INNER JOIN GL_PETTY_CASH_PAYMENT_HDR PCPH ON PCPH.TRANSACTION_POID=PCPD.TRANSACTION_POID
    LEFT JOIN GL_MASTER GM ON GM.GL_POID=PCPD.GL_POID
    WHERE PCPD.TRANSACTION_POID=$P{DOC_KEY_POID} AND PCPD.GL_POID!=PCPH.PETTY_CASH_GL_POID
    )]]>
    </queryString>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="TYPE" class="java.lang.String"/>
    <field name="COMPANY_POID" class="java.math.BigDecimal"/>
    <field name="GL_DESCRIPTION" class="java.lang.String"/>
    <field name="AMOUNT" class="java.math.BigDecimal"/>
    <field name="REMARKS" class="java.lang.String"/>
    <variable name="TOTAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{AMOUNT}]]></variableExpression>
    </variable>
