	<parameter name="SUB_ITEM_DTL_2" class="net.sf.jasperreports.engine.JasperReport"/>
	<queryString>
		<![CDATA[SELECT PCP.TRANSACTION_DATE,PCP.DOC_REF,PCP.CURRENCY_CODE,PCP.CURRENCY_RATE,GM.GL_DESCRIPTION,PCP.BALANCE,
PCP.AMOUNT,PCP.PAYING_TO,PCP.NARRATION,PCP.ADVANCE,PCP.REF_TYPE,PCP.FDA_REF,PCP.FF_REF,PCP.SETTLED_DATE,
PCP.SETTLED_TOTAL,PCP.REMARKS,FN_AMOUNT_IN_WORDS(PCP.AMOUNT) CRSUM,PCP.STATUS,
GET_COMPANY_NAME(PCP.COMPANY_POID) COMPANY,PCP.GRAND_TOTAL,PCP.ROUNDING_AMOUNT,
CASE WHEN PCP.REF_TYPE= 'MTA RFQ' THEN TO_CHAR(RFQ.DOC_REF) ||'/ '||PCP.MTA_REF
     WHEN PCP.REF_TYPE= 'FDA JOBS' THEN TO_CHAR(PFH.DOC_REF)
     WHEN PCP.REF_TYPE= 'FF JOBS' THEN TO_CHAR(T.FF_DOC_REF)
END AS DOC_REF_TYPE, PCP.COMPANY_DIV_POID
FROM GL_PETTY_CASH_PAYMENT_HDR PCP
LEFT JOIN GL_MASTER GM ON GM.GL_POID=PCP.PETTY_CASH_GL_POID
LEFT JOIN PDA_FDA_HDR PFH ON PFH.TRANSACTION_POID=PCP.FDA_REF
LEFT JOIN AP_REQUEST_FOR_QTN_HDR RFQ ON RFQ.TRANSACTION_POID=PCP.SALES_QTN_REF
LEFT JOIN (SELECT LISTAGG (FMH.DOC_REF, '; ') WITHIN GROUP (ORDER BY FMH.DOC_REF) AS FF_DOC_REF,PCP.FF_REF
            FROM FF_MANIEST_HDR FMH
            LEFT JOIN GL_PETTY_CASH_PAYMENT_HDR PCP ON FMH.TRANSACTION_POID IN (SELECT * FROM TABLE(FUNC_GLOB_SPLIT_STRING(PCP.FF_REF,';')))
            WHERE PCP.TRANSACTION_POID=$P{DOC_KEY_POID}
            GROUP BY PCP.FF_REF
            )T  ON  T.FF_REF=PCP.FF_REF
WHERE PCP.TRANSACTION_POID=$P{DOC_KEY_POID}]]>
	</queryString>
