<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="GEN_RECEIPT_PAYMENT_subreport1" language="groovy" pageWidth="400" pageHeight="60" columnWidth="400" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="4febbefb-50ce-417b-a535-d2a685593ce8">
    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="DOC_KEY_ID_PAY" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[select P.TRANSACTION_POID,P.PYMT_TYPE||': '||P.CHQ_CARDNO|| DECODE(P.PYMT_TYPE,'CHEQUE',',Date:'||P.CHQ_DATE||', ',' ')||GET_CUST_BANK_CODE(P.BANK_POID)||'  BD:-'||TRIM(TO_CHAR(P.AMOUNT,'999G999G990D000')) PAYMENT_DTL,
P.ACCOUNT_POID,P.ACCOUNT_NAME,P.ACCOUNT_NO,NVL(HDR.ROUND_OFF,0)ROUNDOFF,NVL(HDR.EX_GAIN_LOSS,0)EXG_GAIN,NVL(HDR.BANK_CHARGES,0)BANK_CHARGES
 from AR_GEN_RECEIPT_PYMT_DETAILS P
 INNER JOIN AR_GEN_RECEIPT_HDR HDR ON HDR.TRANSACTION_POID=P.TRANSACTION_POID
 WHERE P.TRANSACTION_POID=$P{DOC_KEY_ID_PAY}]]>
    </queryString>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="PAYMENT_DTL" class="java.lang.String"/>
    <field name="ACCOUNT_POID" class="java.math.BigDecimal"/>
    <field name="ACCOUNT_NAME" class="java.lang.String"/>
    <field name="ACCOUNT_NO" class="java.lang.String"/>
    <field name="ROUNDOFF" class="java.math.BigDecimal"/>
    <field name="EXG_GAIN" class="java.math.BigDecimal"/>
    <field name="BANK_CHARGES" class="java.math.BigDecimal"/>
    <group name="TRANSACTION_POID">
        <groupExpression><![CDATA[$F{TRANSACTION_POID}]]></groupExpression>
    </group>
