<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CreditNoteDtlSubreportVAT2019" language="groovy" pageWidth="530" pageHeight="802" columnWidth="530" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="c58cc137-8e6b-4988-bb20-80b67cd7b4f9">
    <property name="ireport.zoom" value="2.143588810000003"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[
SELECT TRANSACTION_POID,TYPE,REMARKS,CURRENCY_CODE,SUM(DR_AMT) AS DR_AMT,
TAX_PERCENTAGE , SUM(TAX_AMOUNT) TAX_AMOUNT, SUM(TOTAL_AMOUNT) TOTAL_AMOUNT,
SUM(BHD_TOTAL_DR_AMT) BHD_TOTAL_DR_AMT,
SUM(BHD_TOTAL_TAX) AS BHD_TOTAL_TAX,
SUM(BHD_TOTAL_AMOUNT) AS BHD_TOTAL_AMOUNT,TAX_APPLICABLE
FROM
(
    SELECT CND.TRANSACTION_POID, UPPER(CND.TYPE) AS TYPE, GM.GL_DESCRIPTION,
    NVL(CND.REMARKS,GM.GL_DESCRIPTION) AS REMARKS, CNH.CURRENCY_CODE,
    CASE WHEN CNH.CURRENCY_CODE='BHD' THEN NVL(CND.DR_AMT,0)
    ELSE ROUND(NVL(CND.DR_AMT,0)/CNH.CURRENCY_RATE,2)
    END AS DR_AMT,
    CASE WHEN GTM.TAX_CATEGORY = 'E' THEN 'E'
    WHEN GTM.TAX_CATEGORY = 'OS' THEN 'OS'
    ELSE CAST(NVL(CND.TAX_PERCENTAGE,0 ) AS VARCHAR(10)) END  AS TAX_PERCENTAGE ,
    CASE WHEN CNH.CURRENCY_CODE='BHD' THEN  NVL(CND.TAX_AMOUNT,0)
    ELSE ROUND(NVL(CND.TAX_AMOUNT,0)/CNH.CURRENCY_RATE,2)
    END AS TAX_AMOUNT,
      CASE WHEN CNH.CURRENCY_CODE='BHD' THEN  NVL(CND.TOTAL_AMOUNT,0)
    ELSE ROUND(NVL(CND.TOTAL_AMOUNT,0)/CNH.CURRENCY_RATE,2)
    END AS TOTAL_AMOUNT,
    NVL(CND.DR_AMT,0) AS BHD_TOTAL_DR_AMT,
    NVL(CND.TAX_AMOUNT,0) AS BHD_TOTAL_TAX,
    NVL(CND.TOTAL_AMOUNT,0) AS BHD_TOTAL_AMOUNT,
    CASE WHEN (TRUNC(CNH.TRANSACTION_DATE)>=TRUNC(GCM.VAT_REGISTRATION_DATE) AND EXTRACT(YEAR FROM  CNH.TRANSACTION_DATE)>2018)  THEN
    RTN_GLOBAL_PARAMETER( 1,'GLOBAL_TAX_APPLICABLE','TAX',CNH.COMPANY_POID,NULL) ELSE 'N' END AS TAX_APPLICABLE
    FROM AR_CREDIT_NOTE_DTL CND
    LEFT JOIN GL_MASTER GM ON GM.GL_POID=CND.GL_POID
    INNER JOIN AR_CREDIT_NOTE_HDR CNH ON CNH.TRANSACTION_POID = CND.TRANSACTION_POID
    LEFT JOIN GLOBAL_TAX_MASTER GTM ON GTM.TAX_POID =  CND.TAX_POID
    LEFT JOIN GLOBAL_COMPANY_MASTER GCM ON CNH.COMPANY_POID=GCM.COMPANY_POID
    WHERE UPPER(CND.TYPE)='DR' AND CND.TRANSACTION_POID= $P{DOC_KEY_POID}
)
GROUP BY TRANSACTION_POID, TYPE, REMARKS,
CURRENCY_CODE,TAX_PERCENTAGE , TAX_APPLICABLE]]>
    </queryString>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="TYPE" class="java.lang.String"/>
    <field name="REMARKS" class="java.lang.String"/>
    <field name="CURRENCY_CODE" class="java.lang.String"/>
    <field name="DR_AMT" class="java.math.BigDecimal"/>
    <field name="TAX_PERCENTAGE" class="java.lang.String"/>
    <field name="TAX_AMOUNT" class="java.math.BigDecimal"/>
    <field name="TOTAL_AMOUNT" class="java.math.BigDecimal"/>
    <field name="BHD_TOTAL_DR_AMT" class="java.math.BigDecimal"/>
    <field name="BHD_TOTAL_TAX" class="java.math.BigDecimal"/>
    <field name="BHD_TOTAL_AMOUNT" class="java.math.BigDecimal"/>
    <field name="TAX_APPLICABLE" class="java.lang.String"/>
    <variable name="Total" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{DR_AMT}]]></variableExpression>
    </variable>
    <variable name="RETURN_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{TOTAL_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="BHD_RETURN_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{BHD_TOTAL_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="BHD_TOTAL_TAX" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{BHD_TOTAL_TAX}]]></variableExpression>
    </variable>
    <variable name="BHD_TOTAL_EXCL_VAT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{BHD_TOTAL_DR_AMT}]]></variableExpression>
    </variable>
    <variable name="TOTAL_TAX" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{TAX_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="TOTAL_EXCL_VAT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{DR_AMT}]]></variableExpression>
    </variable>
