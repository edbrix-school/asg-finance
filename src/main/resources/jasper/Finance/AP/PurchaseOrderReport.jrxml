    <parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUB_FOOTER" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUBREPORT_1" class="net.sf.jasperreports.engine.JasperReport"/>
    <queryString>
        <![CDATA[SELECT APO.TRANSACTION_POID, APO.TRANSACTION_DATE, APO.DOC_REF, GCM.COMPANY_NAME,
APO.CURRENCY_CODE AS CURRENCY, APO.CURRENCY_RATE, APO.REF_TYPE, APO.TYPE, APO.DESCRIPTION, APO.EXPECTED_DATE, ASM.SUPPLIER_NAME,
CASE WHEN APO.PAYMENT_TERMS LIKE 'CREDIT' AND NVL(ASM.CREDIT_PERIOD,0) !=0 THEN APO.PAYMENT_TERMS||' - '||ASM.CREDIT_PERIOD||' Days'
ELSE APO.PAYMENT_TERMS END AS PAYMENT_TERMS, APO.COMPANY_POID, APO.PRINT_DIV_POID,
CASE WHEN ASM.TIN_NUMBER IS NOT NULL THEN 'Y'
     WHEN ASM.TIN_NUMBER IS  NULL THEN 'N'
     END AS TAX_APPLICABLE,GCM.TIN_NUMBER AS COMPANY_TIN_NUMBER,ASM.TIN_NUMBER,
APO.DELIVERY_TERMS,APO.EXPENSE_BY_SUPPLIER,APO.GRAND_TOTAL,APO.REMARKS,
CASE WHEN NVL(T.ADDRESS_TYPE,T1.ADDRESS_TYPE)='SHIP_CHANDLING' THEN T.CONTACT_PERSON
ELSE T1.CONTACT_PERSON END  AS CONTACT_PERSON,
CASE WHEN NVL(T.ADDRESS_TYPE,T1.ADDRESS_TYPE)='SHIP_CHANDLING' THEN T.EMAIL1
ELSE T1.EMAIL1 END  AS EMAIL1,
CASE WHEN NVL(T.ADDRESS_TYPE,T1.ADDRESS_TYPE)='SHIP_CHANDLING' THEN T.MOBILE
ELSE T1.MOBILE END  AS MOBILE,
CASE WHEN NVL(T.ADDRESS_TYPE,T1.ADDRESS_TYPE)='SHIP_CHANDLING' THEN T.OFF_TEL1
ELSE T1.OFF_TEL1 END  AS OFF_TEL1,
CASE WHEN NVL(T.ADDRESS_TYPE,T1.ADDRESS_TYPE)='SHIP_CHANDLING' THEN T.PO_BOX
ELSE T1.PO_BOX END  AS PO_BOX,
CASE WHEN NVL(T.ADDRESS_TYPE,T1.ADDRESS_TYPE)='SHIP_CHANDLING' THEN T.AREA_CITY
ELSE T1.AREA_CITY END  AS AREA_CITY,
CASE WHEN NVL(T.ADDRESS_TYPE,T1.ADDRESS_TYPE)='SHIP_CHANDLING' THEN T.LAND_MARK
ELSE T1.LAND_MARK END  AS LAND_MARK,
FN_AMOUNT_IN_WORDS_COMMON(APO.GRAND_TOTAL,APO.CURRENCY_CODE) as TOTAL_IN_WORDS,
CASE WHEN APO.REF_TYPE='MTA' THEN FN_FOR_CUSTOMER_ADDRESS('200-101',APO.SUPPLIER_POID,'SUPPLIER','SHIP_CHANDLING')
     ELSE FN_FOR_CUSTOMER_ADDRESS('200-101',APO.SUPPLIER_POID,'SUPPLIER','MAIN') END AS SUPPLIER_ADDRESS, DELIVERY_ADDRESS
FROM AP_PURCHASE_ORDER_HDR APO
INNER JOIN AP_SUPPLIER_MASTER ASM ON ASM.SUPPLIER_POID=APO.SUPPLIER_POID
LEFT JOIN GLOBAL_COMPANY_MASTER GCM ON GCM.COMPANY_POID=APO.COMPANY_POID
LEFT JOIN GLOBAL_ADDRESS_MASTER GDM ON ASM.ADDRESS_POID=GDM.ADDRESS_MASTER_POID
LEFT JOIN (
SELECT GAD.ADDRESS_TYPE,GAD.CONTACT_PERSON,GAD.EMAIL1,GAD.MOBILE,GAD.OFF_TEL1,
GAD.PO_BOX,GAD.AREA_CITY,GAD.LAND_MARK,GAD.ADDRESS_MASTER_POID
FROM GLOBAL_ADDRESS_DETAILS GAD
WHERE ADDRESS_TYPE IN 'SHIP_CHANDLING'
         )T ON T.ADDRESS_MASTER_POID=GDM.ADDRESS_MASTER_POID
LEFT JOIN (
SELECT GAD.ADDRESS_TYPE,GAD.CONTACT_PERSON,GAD.EMAIL1,GAD.MOBILE,GAD.OFF_TEL1,
GAD.PO_BOX,GAD.AREA_CITY,GAD.LAND_MARK,GAD.ADDRESS_MASTER_POID
FROM GLOBAL_ADDRESS_DETAILS GAD
WHERE ADDRESS_TYPE IN 'MAIN'
         )T1 ON T1.ADDRESS_MASTER_POID=GDM.ADDRESS_MASTER_POID
WHERE APO.TRANSACTION_POID=$P{DOC_KEY_POID} AND ROWNUM=1]]>
    </queryString>
