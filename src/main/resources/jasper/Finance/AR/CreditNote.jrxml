    <parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUB_CREDIT_DTL_1" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUB_CREDIT_DTL_VAT" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUB_CHARGE_1" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="SUB_CHARGE_VAT" class="net.sf.jasperreports.engine.JasperReport"/>
