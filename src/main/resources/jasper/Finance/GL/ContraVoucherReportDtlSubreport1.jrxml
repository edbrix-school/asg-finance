<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ContraVoucherReportDtlSubreport1" language="groovy" pageWidth="530" pageHeight="802" columnWidth="530" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="0319529c-65c6-4237-91b6-37d0881a43d9">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="net.sf.jasperreports.export.pdf.force.linebreak.policy" value="true"/>
	<parameter name="DOC_KEY_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    CVD.DET_ROW_ID,
    CVD.TYPE,
    GM.GL_CODE,
    TRIM(GM.GL_DESCRIPTION) AS GL_DESCRIPTION,
    TRIM(CVD.REMARKS) AS REMARKS,
    CASE
        WHEN CVD.REMARKS IS NOT NULL AND LENGTH(TRIM(CVD.REMARKS)) > 0
        THEN TRIM(CVD.REMARKS)
        WHEN CVH.REMARKS IS NOT NULL AND LENGTH(TRIM(CVH.REMARKS)) > 0
        THEN TRIM(CVH.REMARKS)
        ELSE NULL
    END AS LINE_REMARKS,
    NVL(TRIM(GM.GL_DESCRIPTION), '') ||
    CASE
        WHEN CVD.REMARKS IS NOT NULL AND LENGTH(TRIM(CVD.REMARKS)) > 0
        THEN CHR(10) || TRIM(CVD.REMARKS)
        WHEN CVH.REMARKS IS NOT NULL AND LENGTH(TRIM(CVH.REMARKS)) > 0
        THEN CHR(10) || TRIM(CVH.REMARKS)
        ELSE ''
    END AS GL_DESC_BLOCK,
    CVD.DR_AMT,
    CVD.CR_AMT
FROM GL_CONTRA_VOUCHER_DTL CVD
INNER JOIN GL_CONTRA_VOUCHER_HDR CVH ON CVH.TRANSACTION_POID = CVD.TRANSACTION_POID
LEFT JOIN GL_MASTER GM ON GM.GL_POID = CVD.GL_POID
WHERE CVD.TRANSACTION_POID = $P{DOC_KEY_POID}
ORDER BY CVD.DET_ROW_ID]]>
	</queryString>
	<field name="DET_ROW_ID" class="java.math.BigDecimal"/>
	<field name="TYPE" class="java.lang.String"/>
	<field name="GL_CODE" class="java.lang.String"/>
	<field name="GL_DESCRIPTION" class="java.lang.String"/>
	<field name="REMARKS" class="java.lang.String"/>
	<field name="LINE_REMARKS" class="java.lang.String"/>
	<field name="GL_DESC_BLOCK" class="java.lang.String"/>
	<field name="DR_AMT" class="java.math.BigDecimal"/>
	<field name="CR_AMT" class="java.math.BigDecimal"/>
	<variable name="DR_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DR_AMT}]]></variableExpression>
	</variable>
	<variable name="CR_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{CR_AMT}]]></variableExpression>
	</variable>
