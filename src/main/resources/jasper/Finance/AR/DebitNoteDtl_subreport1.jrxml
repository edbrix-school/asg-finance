<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DebitNoteDtl_subreport1" language="groovy" pageWidth="521" pageHeight="400" columnWidth="521" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="84afab5e-d72b-4676-90f7-f0292dcf78cb">
    <property name="ireport.zoom" value="2.593742460100003"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT DND.TRANSACTION_POID,DND.TYPE,GM.GL_DESCRIPTION,CNH.USD_ONLY,
DND.DR_AMT,DND.CR_AMT,NVL(DND.REMARKS,GM.GL_DESCRIPTION) AS REMARKS,ROUND(DND.CR_AMT/CNH.CURRENCY_RATE,2) AS USD,CNH.CURRENCY_CODE,
CASE WHEN  (TRUNC(CNH.TRANSACTION_DATE)>=TRUNC(GCM.VAT_REGISTRATION_DATE) AND EXTRACT(YEAR FROM  CNH.TRANSACTION_DATE)>2018)  THEN
RTN_GLOBAL_PARAMETER( 1,'GLOBAL_TAX_APPLICABLE','TAX',CNH.COMPANY_POID,NULL) ELSE 'N' END AS TAX_APPLICABLE
FROM AR_DEBIT_NOTE_DTL DND
LEFT JOIN GL_MASTER GM ON GM.GL_POID=DND.GL_POID
INNER JOIN AR_DEBIT_NOTE_HDR CNH ON CNH.TRANSACTION_POID = DND.TRANSACTION_POID
LEFT JOIN GLOBAL_COMPANY_MASTER GCM ON CNH.COMPANY_POID=GCM.COMPANY_POID
WHERE DND.TRANSACTION_POID=$P{DOC_KEY_POID} AND UPPER(DND.TYPE)='CR']]>
    </queryString>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="TYPE" class="java.lang.String"/>
    <field name="GL_DESCRIPTION" class="java.lang.String"/>
    <field name="USD_ONLY" class="java.lang.String"/>
    <field name="DR_AMT" class="java.math.BigDecimal"/>
    <field name="CR_AMT" class="java.math.BigDecimal"/>
    <field name="REMARKS" class="java.lang.String"/>
    <field name="USD" class="java.math.BigDecimal"/>
    <field name="CURRENCY_CODE" class="java.lang.String"/>
    <field name="TAX_APPLICABLE" class="java.lang.String"/>
    <variable name="Total" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{CR_AMT}]]></variableExpression>
    </variable>
    <variable name="RETURN_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[($F{CURRENCY_CODE}=="BHD") ? $F{CR_AMT} : $F{USD}]]></variableExpression>
    </variable>
    <variable name="BHD_RETURN_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{CR_AMT}]]></variableExpression>
    </variable>
