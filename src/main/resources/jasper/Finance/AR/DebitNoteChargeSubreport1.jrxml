<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DebitNoteChargeSubreport1" language="groovy" pageWidth="521" pageHeight="802" columnWidth="521" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="a07fe0ef-932d-4384-ad4f-c652111ff74e">
    <property name="ireport.zoom" value="1.3310000000000015"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT TRANSACTION_POID, CHARGE_NAME,DESCRIPTION, REMARKS,REMARKS_PRINTABLE, CURRENCY_CODE, CHECK_ALL,
USD_ONLY,TAX_PERCENTAGE , SUM(CHARGE_AMOUNT) AS CHARGE_AMOUNT,
SUM(CASE WHEN USD_ONLY = 'Y' THEN USD_TAX_AMOUNT ELSE TAX_AMOUNT END)  AS TAX_AMOUNT,
SUM(CASE WHEN USD_ONLY = 'Y' THEN USD_ACTUAL_AMOUNT ELSE ACTUAL_AMOUNT END) AS ACTUAL_AMOUNT,
SUM(PDA_AMOUNT) AS PDA_AMOUNT, SUM(USD) AS USD,
SUM(TAX_AMOUNT) AS BHD_TAX_AMOUNT,
SUM(ACTUAL_AMOUNT) AS BHD_ACTUAL_AMOUNT,
CASE WHEN  EXTRACT(YEAR FROM TRANSACTION_DATE)>2018  THEN
RTN_GLOBAL_PARAMETER( 1,'GLOBAL_TAX_APPLICABLE','TAX',COMPANY_POID,NULL) ELSE 'N' END AS TAX_APPLICABLE
FROM(
    SELECT DNCD.TRANSACTION_POID,DECODE(DNH.REMARKS_PRINTABLE,'N',SCM.CHARGE_NAME,'Y',NVL(DNCD.REMARKS,SCM.CHARGE_NAME)) AS CHARGE_NAME,
    (DNCD.CHARGE_AMOUNT+NVL(DNCD.TAX_AMOUNT,0)) AS CHARGE_AMOUNT,DNH.USD_ONLY,DNCD.DESCRIPTION, DNCD.REMARKS,
    DNCD.CHECK_ALL, DNCD.PDA_AMOUNT, DNH.REMARKS_PRINTABLE,DNH.COMPANY_POID,
    DNH.CURRENCY_CODE, ROUND((DNCD.CHARGE_AMOUNT+NVL(DNCD.TAX_AMOUNT,0))/DNH.CURRENCY_RATE,2) AS USD,
    CASE WHEN GTM.TAX_CATEGORY = 'E' THEN 'E'  ELSE CAST(NVL(DNCD.TAX_PERCENTAGE,0 ) AS VARCHAR(10)) END  AS TAX_PERCENTAGE ,
    NVL(DNCD.TAX_AMOUNT,0) AS TAX_AMOUNT,DNCD.CHARGE_AMOUNT AS ACTUAL_AMOUNT, DNH.CURRENCY_RATE, DNH.TRANSACTION_DATE,
    ROUND(NVL(DNCD.TAX_AMOUNT,0)/CURRENCY_RATE,2) AS USD_TAX_AMOUNT,
    ROUND(DNCD.CHARGE_AMOUNT/CURRENCY_RATE,2) AS USD_ACTUAL_AMOUNT
    FROM AR_DEBIT_NOTE_CHARGE_DTL DNCD
    INNER JOIN AR_DEBIT_NOTE_HDR DNH ON DNH.TRANSACTION_POID = DNCD.TRANSACTION_POID
    LEFT JOIN SHIP_CHARGE_MASTER SCM ON SCM.CHARGE_POID=DNCD.CHARGE_POID
    LEFT JOIN GLOBAL_TAX_MASTER GTM ON GTM.TAX_POID =  DNCD.TAX_POID
    WHERE DNCD.TRANSACTION_POID =  $P{DOC_KEY_POID}
   )
GROUP BY TRANSACTION_POID, CHARGE_NAME, DESCRIPTION, REMARKS,REMARKS_PRINTABLE,
CURRENCY_CODE,CHECK_ALL, USD_ONLY, TAX_PERCENTAGE, COMPANY_POID, TRANSACTION_DATE]]>
    </queryString>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="CHARGE_NAME" class="java.lang.String"/>
    <field name="DESCRIPTION" class="java.lang.String"/>
    <field name="REMARKS" class="java.lang.String"/>
    <field name="REMARKS_PRINTABLE" class="java.lang.String"/>
    <field name="CURRENCY_CODE" class="java.lang.String"/>
    <field name="CHECK_ALL" class="java.lang.String"/>
    <field name="USD_ONLY" class="java.lang.String"/>
    <field name="TAX_PERCENTAGE" class="java.lang.String"/>
    <field name="CHARGE_AMOUNT" class="java.math.BigDecimal"/>
    <field name="TAX_AMOUNT" class="java.math.BigDecimal"/>
    <field name="ACTUAL_AMOUNT" class="java.math.BigDecimal"/>
    <field name="PDA_AMOUNT" class="java.math.BigDecimal"/>
    <field name="USD" class="java.math.BigDecimal"/>
    <field name="BHD_TAX_AMOUNT" class="java.math.BigDecimal"/>
    <field name="BHD_ACTUAL_AMOUNT" class="java.math.BigDecimal"/>
    <field name="TAX_APPLICABLE" class="java.lang.String"/>
    <variable name="TOTAL_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{CHARGE_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="TOTAL_USD" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{USD}]]></variableExpression>
    </variable>
    <variable name="TOTAL_TAX" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{BHD_TAX_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="TOTAL_EXCL_VAT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{BHD_ACTUAL_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="RETURN_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[($F{CURRENCY_CODE}=="BHD") ? $F{CHARGE_AMOUNT} : $V{TOTAL_USD}]]></variableExpression>
    </variable>
