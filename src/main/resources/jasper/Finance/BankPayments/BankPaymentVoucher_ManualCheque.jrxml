    <parameter name="SUB_FOOTER_ISO" class="net.sf.jasperreports.engine.JasperReport"/>
    <queryString>
        <![CDATA[select distinct HDR.TRANSACTION_POID,HDR.paying_to,HDR.doc_ref,TO_CHAR(HDR.transaction_date,'DD-MON-YYYY') transaction_date,TO_CHAR(HDR.CHQ_DATE,'DD-MON-YYYY')CHQ_DATE,
HDR.CURRENCY_AMOUNT,HDR.REF_TYPE,HDR.CHQ_CARDNO AS CURRENT_CHQ_NO, BKHDR.BANK_PREFIX,HDR.long_narration,BKHDR.bank_description,HDR.PRINT_WITHOUT_BILLWISE,
'BD:'||' '||FN_AMOUNT_IN_WORDS_COMMON(HDR.CURRENCY_AMOUNT,'BHD') AMOUNT_IN_WORD,
HDR.CREATED_BY
FROM GL_BANK_PAYMENT_HDR HDR
INNER JOIN GL_BANK_MASTER BKHDR
ON HDR.BANK_POID = BKHDR.BANK_POID
WHERE TRANSACTION_POID = $P{DOC_KEY_POID}]]>
    </queryString>
