<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CreditNoteChargeSubreportVAT2019" language="groovy" pageWidth="521" pageHeight="802" columnWidth="521" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="a07fe0ef-932d-4384-ad4f-c652111ff74e">
    <property name="ireport.zoom" value="2.1435888100000033"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT TRANSACTION_POID, CHARGE_NAME, DESCRIPTION, REMARKS, CURRENCY_CODE, CHECK_ALL, REMARKS_PRINTABLE,
TAX_PERCENTAGE ,  SUM(CHARGE_AMOUNT) AS CHARGE_AMOUNT,SUM(TAX_AMOUNT) AS TAX_AMOUNT, SUM(TOTAL_AMOUNT) AS TOTAL_AMOUNT,
CASE WHEN  (TRUNC(TRANSACTION_DATE)>=TRUNC(VAT_REGISTRATION_DATE) AND EXTRACT(YEAR FROM TRANSACTION_DATE)>2018)  THEN
RTN_GLOBAL_PARAMETER( 1,'GLOBAL_TAX_APPLICABLE','TAX',COMPANY_POID,NULL) ELSE 'N' END AS TAX_APPLICABLE,
SUM(BHD_CHARGE_AMOUNT) AS BHD_CHARGE_AMOUNT, SUM(BHD_TAX_AMOUNT) AS BHD_TAX_AMOUNT, SUM(BHD_TOTAL_AMOUNT) AS BHD_TOTAL_AMOUNT
FROM(
 SELECT CNCD.TRANSACTION_POID,NVL(ST.PRINT_GROUP, CASE WHEN CNH.REMARKS_PRINTABLE = 'Y' THEN CNCD.REMARKS ELSE SCM.CHARGE_NAME END )  AS CHARGE_NAME,
           CNCD.DESCRIPTION, CNCD.REMARKS, CNH.COMPANY_POID, CNH.CURRENCY_CODE, CNH.CURRENCY_RATE, CNCD.CHECK_ALL,
           CASE WHEN CNH.CURRENCY_CODE='BHD' THEN NVL(CNCD.CHARGE_AMOUNT,0)
                ELSE ROUND(NVL(CNCD.CHARGE_AMOUNT,0)/CNH.CURRENCY_RATE,2)
           END AS CHARGE_AMOUNT,
           NVL(CNCD.CHARGE_AMOUNT,0) AS BHD_CHARGE_AMOUNT,
          (DECODE(GTM.TAX_CATEGORY,'V',TO_CHAR(CNCD.TAX_PERCENTAGE),'Z','0',TAX_CATEGORY))  AS TAX_PERCENTAGE ,
          CASE WHEN CNH.CURRENCY_CODE='BHD' THEN NVL(CNCD.TAX_AMOUNT,0)
                ELSE ROUND(NVL(CNCD.TAX_AMOUNT,0)/CNH.CURRENCY_RATE,2)
          END AS TAX_AMOUNT,
          NVL(CNCD.TAX_AMOUNT,0) AS BHD_TAX_AMOUNT,
          CASE WHEN CNH.CURRENCY_CODE='BHD' THEN (NVL(CNCD.CHARGE_AMOUNT,0)+NVL(CNCD.TAX_AMOUNT,0))
                ELSE ROUND((ROUND(NVL(CNCD.CHARGE_AMOUNT,0)/CNH.CURRENCY_RATE,2)+ROUND(NVL(CNCD.TAX_AMOUNT,0)/CNH.CURRENCY_RATE,2)),2)
          END AS TOTAL_AMOUNT,
          (NVL(CNCD.CHARGE_AMOUNT,0)+NVL(CNCD.TAX_AMOUNT,0)) AS BHD_TOTAL_AMOUNT,
          TRUNC(GCM.VAT_REGISTRATION_DATE) AS VAT_REGISTRATION_DATE,CNH.TRANSACTION_DATE, CNH.REMARKS_PRINTABLE
    FROM AR_CREDIT_NOTE_CHARGE_DTL CNCD
    INNER JOIN AR_CREDIT_NOTE_HDR CNH ON CNH.TRANSACTION_POID = CNCD.TRANSACTION_POID
    LEFT JOIN
    (
        SELECT DISTINCT MFCHGD.PRINT_GROUP,CNCDST.TRANSACTION_POID, CNCDST.det_row_id
        FROM AR_SH_SALES_INVOICE_HDR SHDRST
        INNER JOIN AR_CREDIT_NOTE_CHARGE_DTL CNCDST  ON CNCDST.REF_DOC_POID=SHDRST.TRANSACTION_POID
        LEFT JOIN  SHIP_BL_MANIFEST_CHARGES_DTL MFCHGD ON MFCHGD.TRANSACTION_POID=SHDRST.BL_POID
        AND MFCHGD.CHARGE_POID=CNCDST.CHARGE_POID AND PER_QUANTITY_AMOUNT<0 AND MFCHGD.CN_REF_DET_ROW_ID=CNCDST.DET_ROW_ID
        WHERE CNCDST.TRANSACTION_POID = $P{DOC_KEY_POID}
    ) ST ON CNCD.TRANSACTION_POID  = ST.TRANSACTION_POID and CNCD.det_row_id=st.det_row_id
    LEFT JOIN SHIP_CHARGE_MASTER SCM ON SCM.CHARGE_POID=CNCD.CHARGE_POID
    LEFT JOIN GLOBAL_TAX_MASTER GTM ON GTM.TAX_POID =  CNCD.TAX_POID
    LEFT JOIN GLOBAL_COMPANY_MASTER GCM ON CNH.COMPANY_POID=GCM.COMPANY_POID
    WHERE CNCD.TRANSACTION_POID = $P{DOC_KEY_POID}
   )
GROUP BY TRANSACTION_POID, CHARGE_NAME, DESCRIPTION, REMARKS, CURRENCY_CODE, CHECK_ALL, TAX_PERCENTAGE,
COMPANY_POID, TRANSACTION_DATE, VAT_REGISTRATION_DATE, REMARKS_PRINTABLE]]>
    </queryString>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="CHARGE_NAME" class="java.lang.String"/>
    <field name="DESCRIPTION" class="java.lang.String"/>
    <field name="REMARKS" class="java.lang.String"/>
    <field name="CURRENCY_CODE" class="java.lang.String"/>
    <field name="CHECK_ALL" class="java.lang.String"/>
    <field name="REMARKS_PRINTABLE" class="java.lang.String"/>
    <field name="TAX_PERCENTAGE" class="java.lang.String"/>
    <field name="CHARGE_AMOUNT" class="java.math.BigDecimal"/>
    <field name="TAX_AMOUNT" class="java.math.BigDecimal"/>
    <field name="TOTAL_AMOUNT" class="java.math.BigDecimal"/>
    <field name="TAX_APPLICABLE" class="java.lang.String"/>
    <field name="BHD_CHARGE_AMOUNT" class="java.math.BigDecimal"/>
    <field name="BHD_TAX_AMOUNT" class="java.math.BigDecimal"/>
    <field name="BHD_TOTAL_AMOUNT" class="java.math.BigDecimal"/>
    <variable name="TOTAL_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{TOTAL_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="TOTAL_TAX" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{TAX_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="TOTAL_EXCL_VAT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{CHARGE_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="BHD_TOTAL_AMOUNT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{BHD_TOTAL_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="BHD_TOTAL_TAX" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{BHD_TAX_AMOUNT}]]></variableExpression>
    </variable>
    <variable name="BHD_TOTAL_EXCL_VAT" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{BHD_CHARGE_AMOUNT}]]></variableExpression>
    </variable>
