	<parameter name="LOGIN_GROUP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_COMP_POID" class="java.lang.String">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="LOGIN_USER_POID" class="java.lang.String"/>
	<parameter name="LOGIN_DIV_POID" class="java.lang.String"/>
	<parameter name="DOC_ID" class="java.lang.String"/>
	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<parameter name="SUB_HEADER" class="net.sf.jasperreports.engine.JasperReport"/>
	<parameter name="SUB_FOOTER_ISO" class="net.sf.jasperreports.engine.JasperReport"/>
	<queryString>
		<![CDATA[SELECT H.TRANSACTION_POID,
       H.DOC_REF,
       H.TRANSACTION_DATE,
       H.PERIOD_FROM,
       H.PERIOD_TO,
       H.REMARKS,
       C.COMPANY_NAME,
       D.DET_ROW_ID,
       D.TAX_TYPE,
       D.TAX_CODE,
       D.TAX_DESCRIPTION,
       D.TAX_BASE_AMOUNT,
       D.TAX_AMOUNT,
       D.TOTAL_AMOUNT
  FROM GLOBAL_TAX_SUBMISSION_HDR H
  LEFT JOIN GLOBAL_COMPANY_MASTER C
    ON C.COMPANY_POID = H.COMPANY_POID
  LEFT JOIN GLOBAL_TAX_SUBMISSION_DTL D
    ON D.TRANSACTION_POID = H.TRANSACTION_POID
 WHERE H.TRANSACTION_POID = $P{DOC_KEY_POID}
 ORDER BY D.DET_ROW_ID]]>
	</queryString>
	<field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
	<field name="DOC_REF" class="java.lang.String"/>
	<field name="TRANSACTION_DATE" class="java.sql.Timestamp"/>
	<field name="PERIOD_FROM" class="java.sql.Timestamp"/>
	<field name="PERIOD_TO" class="java.sql.Timestamp"/>
	<field name="REMARKS" class="java.lang.String"/>
	<field name="COMPANY_NAME" class="java.lang.String"/>
	<field name="DET_ROW_ID" class="java.math.BigDecimal"/>
	<field name="TAX_TYPE" class="java.lang.String"/>
	<field name="TAX_CODE" class="java.lang.String"/>
	<field name="TAX_DESCRIPTION" class="java.lang.String"/>
	<field name="TAX_BASE_AMOUNT" class="java.math.BigDecimal"/>
	<field name="TAX_AMOUNT" class="java.math.BigDecimal"/>
	<field name="TOTAL_AMOUNT" class="java.math.BigDecimal"/>
	<variable name="BASE_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TAX_BASE_AMOUNT}]]></variableExpression>
	</variable>
	<variable name="TAX_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TAX_AMOUNT}]]></variableExpression>
	</variable>
	<variable name="GRAND_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL_AMOUNT}]]></variableExpression>
	</variable>
