    </parameter>
    <parameter name="DOC_KEY_POID" class="java.lang.String"/>
    <parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["\\\\shippingbahrain.com\\data\\ERP_REPORTS\\Reports\\"]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT HDR.TRANSACTION_POID,HDR.TRANSACTION_DATE,GET_COMPANY_NAME(HDR.PRINT_DOC_COMP_ID)COMPANY,HDR.DOC_REF,HDR.PRINT_DOC_COMP_ID,HDR.COMPANY_POID,
DECODE(HDR.RCVD_FROM_DTL_PRINT,NULL,GL.GL_DESCRIPTION,HDR.RCVD_FROM_DTL_PRINT) Rcvd_from,GL.GL_DESCRIPTION,HDR.RCPT_AMOUNT,HDR.CREATED_BY,
GET_GEN_RCPT_SUM(HDR.TRANSACTION_POID)RCPT_AMOUNT_DTL_SUM,FN_AMOUNT_IN_WORDS(nvl(GET_GEN_RCPT_SUM(HDR.TRANSACTION_POID),0))AMT_WRDS,HDR.REMARKS,
nvl(GA1.PO_BOX,'') AS PO_BOX,
nvl(GA1.BLDG,'') AS BUILDING,
nvl(GA1.STATE,'') AS STATE,
nvl(GA1.EMAIL1,'') AS EMAIL,
nvl(GA1.OFF_TEL1,'') AS OFFICE_TEL,
nvl(GA1.MOBILE,'--') AS MOBILE,
CASE WHEN GL.GL_DESCRIPTION=HDR.RCVD_FROM_DTL_PRINT THEN 'Y'
ELSE 'N'
END AS YES_NO,
FUNC_FOR_GL_ADDRESS(HDR.RCVD_OTH_POID,'300-105',$P{DOC_KEY_POID}) AS CREDIT_GL_ADDRESS
FROM AR_GEN_RECEIPT_HDR  HDR
INNER JOIN GL_MASTER GL ON GL.GL_POID=HDR.RCVD_OTH_POID
LEFT JOIN SALES_CUSTOMER_MASTER SM
ON HDR.RCVD_OTH_POID=SM.GL_POID
LEFT JOIN GLOBAL_ADDRESS_DETAILS GA1
ON SM.ADDRESS_POID = GA1.ADDRESS_MASTER_POID AND GA1.ADDRESS_TYPE='MAIN'
LEFT JOIN GLOBAL_ADDRESS_MASTER GA
ON GA1.ADDRESS_MASTER_POID = GA.ADDRESS_MASTER_POID
WHERE TRANSACTION_POID=$P{DOC_KEY_POID}]]>
    </queryString>
