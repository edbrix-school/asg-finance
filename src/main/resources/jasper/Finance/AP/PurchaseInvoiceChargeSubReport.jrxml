	<parameter name="DOC_KEY_POID" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT PIC.TRANSACTION_POID, PIC.DET_ROW_ID, SCM.CHARGE_NAME, PIC.CHARGE_BASE_AMOUNT, PIC.TAX_AMOUNT, PIC.CHARGE_AMOUNT
FROM AP_PURCHASE_INVOICE_CHARGE_DTL PIC
INNER JOIN SHIP_CHARGE_MASTER SCM ON SCM.CHARGE_POID = PIC.CHARGE_POID
WHERE PIC.TRANSACTION_POID = $P{DOC_KEY_POID}]]>
	</queryString>
