<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PurchaseInvoiceItemSubreport1" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="93eb8368-599b-4df3-96b7-bda652398817">
    <property name="ireport.zoom" value="1.210000000000001"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="DOC_KEY_POID" class="java.lang.String">
        <defaultValueExpression><![CDATA[]]></defaultValueExpression>
    </parameter>
    <queryString>
        <![CDATA[SELECT
    PII.TRANSACTION_POID, PII.DET_ROW_ID,SM.STOCK_NAME AS STOCK_NAME,
    SU.STOCK_UNIT_NAME, PII.PO_QTY, PII.DN_QTY,
    PII.QTY_RECEIVED, PII.PRICE, PII.DISCOUNT, PII.PRICE*PII.PO_QTY AS TOTAL, PII.REMARKS,
    PII.REF_DOC_ID, PII.REF_DOC_POID
  FROM
    AP_PURCHASE_INVOICE_ITEM_DTL PII
  LEFT JOIN STOCK_MASTER SM
  ON
    SM.STOCK_POID =PII.STOCK_POID
  LEFT JOIN STOCK_UNIT_MASTER SU
  ON
    SU.STOCK_UNIT_POID=PII.STOCK_UNIT_POID
WHERE PII.TRANSACTION_POID=$P{DOC_KEY_POID}]]>
    </queryString>
    <field name="TRANSACTION_POID" class="java.math.BigDecimal"/>
    <field name="DET_ROW_ID" class="java.math.BigDecimal"/>
    <field name="STOCK_NAME" class="java.lang.String"/>
    <field name="STOCK_UNIT_NAME" class="java.lang.String"/>
    <field name="PO_QTY" class="java.math.BigDecimal"/>
    <field name="DN_QTY" class="java.math.BigDecimal"/>
    <field name="QTY_RECEIVED" class="java.math.BigDecimal"/>
    <field name="PRICE" class="java.math.BigDecimal"/>
    <field name="DISCOUNT" class="java.math.BigDecimal"/>
    <field name="TOTAL" class="java.math.BigDecimal"/>
    <field name="REMARKS" class="java.lang.String"/>
    <field name="REF_DOC_ID" class="java.lang.String"/>
    <field name="REF_DOC_POID" class="java.math.BigDecimal"/>
    <variable name="ITEM_TOTAL" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{TOTAL}]]></variableExpression>
    </variable>
